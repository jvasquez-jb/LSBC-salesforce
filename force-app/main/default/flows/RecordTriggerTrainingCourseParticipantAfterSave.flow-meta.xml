<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>IsThisTheFirstRecordForTheHolder</name>
        <label>Is This The First Record For The Holder In This Save?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, an earlier record syncs</defaultConnectorLabel>
        <rules>
            <name>First</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetHolderFirstRecordInSameSave.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SyncStopCodes</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>After hours are entered or corrected, re-checks automatic stop codes for the student. One sync per student per save, so a monthly import does not open duplicate holds.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Training Course Participant After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Training Course Participant After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHolderFirstRecordInSameSave</name>
        <description>The holder's first record of this object in the same save, by Id. Only that record's run syncs, so a bulk save gives one sync per holder and no duplicate holds.</description>
        <label>Get Holder First Record In Same Save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThisTheFirstRecordForTheHolder</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TrainingCourseParticipant</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetHolderFirstRecordInSameSave</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.TotalHours}) || ISCHANGED({!$Record.EndDate}) || ISCHANGED({!$Record.CourseOfferingId})</filterFormula>
        <object>TrainingCourseParticipant</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncStopCodes</name>
        <label>Sync Stop Codes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.Contact.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
