<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>IsThisTheFirstRecordForTheHolder</name>
        <label>Is This The First Record For The Holder In This Save?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, an earlier record queues the sync</defaultConnectorLabel>
        <rules>
            <name>First</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetHolderFirstRecordInSameSave.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetHolderStopCodeSyncPendingToTrue</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>After hours are entered or corrected, queues a re-check of automatic stop codes for the student. Continuing education attendance is not student hours and is skipped. One sync per student per save, so a monthly import does not open duplicate holds. The re-check runs in the background a few seconds after the save (Record-Trigger: Account After Save).</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Training Course Participant After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Training Course Participant After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHolderFirstRecordInSameSave</name>
        <description>The holder's first record of this object in the same save, by Id. Only that record's run ticks Stop Code Sync Pending on the holder, so a bulk save queues one background sync per holder.</description>
        <label>Get Holder First Record In Same Save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThisTheFirstRecordForTheHolder</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TrainingCourseParticipant</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>SetHolderStopCodeSyncPendingToTrue</name>
        <description>Queues the background stop code sync for the holder (Record-Trigger: Account After Save) instead of syncing during this save.</description>
        <label>Set Holder Stop Code Sync Pending to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Contact.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>StopCodeSyncPending__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>StopCodeSyncPending__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetHolderFirstRecordInSameSave</targetReference>
        </connector>
        <filterFormula>NOT(ISPICKVAL({!$Record.EntryType__c}, &quot;Continuing Education&quot;)) &amp;&amp; (ISNEW() || ISCHANGED({!$Record.TotalHours}) || ISCHANGED({!$Record.EndDate}) || ISCHANGED({!$Record.CourseOfferingId}) || ISCHANGED({!$Record.ReceivedDate__c}))</filterFormula>
        <object>TrainingCourseParticipant</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
