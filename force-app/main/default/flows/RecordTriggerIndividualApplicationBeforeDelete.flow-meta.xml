<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Before an individual application is deleted, queues a re-check of automatic stop codes for the applicant, as an edit does (Record-Trigger: Individual Application After Save). The re-check runs in the background a few seconds after the delete (Record-Trigger: Account After Save), once the application is gone: for example codes 4 and 17 depend on open applications.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Individual Application Before Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Individual Application Before Delete</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>SetHolderStopCodeSyncPendingToTrue</name>
        <description>Queues the background stop code sync for the holder (Record-Trigger: Account After Save), which runs once the record is gone.</description>
        <label>Set Holder Stop Code Sync Pending to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>StopCodeSyncPending__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>StopCodeSyncPending__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SetHolderStopCodeSyncPendingToTrue</targetReference>
        </connector>
        <object>IndividualApplication</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
