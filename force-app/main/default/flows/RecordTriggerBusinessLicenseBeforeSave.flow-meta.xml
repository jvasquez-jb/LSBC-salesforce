<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>SetAccountIdToPersonAccount</name>
        <label>Set Account Id to Person Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Contact.AccountId</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SetContactIdToPersonContact</name>
        <label>Set Contact Id to Person Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.ContactId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.PersonContactId</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>WhichPersonLinkIsMissing</name>
        <label>Which Person Link Is Missing?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>OrganizationMissing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetAccountIdToPersonAccount</targetReference>
            </connector>
            <label>Organization Missing</label>
        </rules>
        <rules>
            <name>ContactMissing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetContactIdToPersonContact</targetReference>
            </connector>
            <label>Contact Missing</label>
        </rules>
    </decisions>
    <description>Keeps a person's license linked both ways. When a license is saved with a Contact but no Organization, and the Contact is a person, fills in Organization with that person's account: licenses show on the person's Licenses tab and are checked for stop codes by Organization. When it is saved with a person as Organization but no Contact (for example from New License on the person), fills in Contact with that person, as on migrated licenses.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Business License Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Business License Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>WhichPersonLinkIsMissing</targetReference>
        </connector>
        <filterFormula>(ISBLANK({!$Record.AccountId}) &amp;&amp; NOT(ISBLANK({!$Record.ContactId}))) || (ISBLANK({!$Record.ContactId}) &amp;&amp; NOT(ISBLANK({!$Record.AccountId})))</filterFormula>
        <object>BusinessLicense</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
