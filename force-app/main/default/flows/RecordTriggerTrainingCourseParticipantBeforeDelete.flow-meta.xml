<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Before an hours entry is deleted, queues a re-check of automatic stop codes for the student, as an edit does (Record-Trigger: Training Course Participant After Save). The re-check runs in the background a few seconds after the delete (Record-Trigger: Account After Save), once the entry is gone: for example code 20 (no hours for 180 days) follows the remaining entries. Continuing education attendance is skipped.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Training Course Participant Before Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Training Course Participant Before Delete</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>SetHolderStopCodeSyncPendingToTrue</name>
        <description>Queues the background stop code sync for the holder (Record-Trigger: Account After Save), which runs once the record is gone.</description>
        <label>Set Holder Stop Code Sync Pending to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Contact.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>StopCodeSyncPending__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>StopCodeSyncPending__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SetHolderStopCodeSyncPendingToTrue</targetReference>
        </connector>
        <filterFormula>NOT(ISPICKVAL({!$Record.EntryType__c}, &quot;Continuing Education&quot;)) &amp;&amp; NOT(ISPICKVAL({!$Record.EntryType__c}, &quot;Termination&quot;))</filterFormula>
        <object>TrainingCourseParticipant</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
