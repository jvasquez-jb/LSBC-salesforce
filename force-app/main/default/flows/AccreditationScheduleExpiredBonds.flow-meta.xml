<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>IsThisInTheWindow</name>
        <label>Is This In The Window?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>InWindow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forB_IsInWindow</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetHolderFirstRecord</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsThisTheHoldersFirstRecord</name>
        <label>Is This The Holder's First Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>First</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetHolderFirstRecord.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SyncStopCodes</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Nightly. Re-checks stop codes for schools whose surety bond ended in the last week. One sync per school.</description>
    <environments>Default</environments>
    <formulas>
        <name>forB_IsInWindow</name>
        <description>True when the date this schedule watches fell in the last seven days.</description>
        <dataType>Boolean</dataType>
        <expression>{!$Record.EffectiveTo} &gt;= TODAY() - 7 &amp;&amp; {!$Record.EffectiveTo} &lt; TODAY()</expression>
    </formulas>
    <formulas>
        <name>forD_WindowStart</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 7</expression>
    </formulas>
    <formulas>
        <name>forD_WindowEnd</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>forDT_WindowStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY() - 7)</expression>
    </formulas>
    <formulas>
        <name>forDT_WindowEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>forD_LapseWindowStart</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(), -36) - 7</expression>
    </formulas>
    <formulas>
        <name>forD_LapseWindowEnd</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(), -36)</expression>
    </formulas>
    <formulas>
        <name>forDT_LapseWindowStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(ADDMONTHS(TODAY(), -36) - 7)</expression>
    </formulas>
    <formulas>
        <name>forDT_LapseWindowEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(ADDMONTHS(TODAY(), -36))</expression>
    </formulas>
    <formulas>
        <name>forDT_StaleWindowStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(ADDMONTHS(TODAY(), -6) - 7)</expression>
    </formulas>
    <formulas>
        <name>forDT_StaleWindowEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(ADDMONTHS(TODAY(), -6))</expression>
    </formulas>
    <interviewLabel>Accreditation Schedule: Expired Bonds {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Accreditation Schedule: Expired Bonds</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHolderFirstRecord</name>
        <description>The holder's first matching record in the window. Only that record's run syncs, so a holder with several records gets one sync and no duplicate holds.</description>
        <label>Get Holder First Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThisTheHoldersFirstRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Surety Bond</stringValue>
            </value>
        </filters>
        <filters>
            <field>EffectiveTo</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>forD_WindowStart</elementReference>
            </value>
        </filters>
        <filters>
            <field>EffectiveTo</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>forD_WindowEnd</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Accreditation</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsThisInTheWindow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Surety Bond</stringValue>
            </value>
        </filters>
        <object>Accreditation</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-10</startDate>
            <startTime>00:40:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncStopCodes</name>
        <label>Sync Stop Codes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
