<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>IsThisTheFirstRecordForTheItem</name>
        <label>Is This The First Record For The Fee Item In This Save?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DidTheFeeItemChange</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, an earlier record syncs</defaultConnectorLabel>
        <rules>
            <name>First</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetItemFirstRecordInSameSave.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FeeItem__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SyncFeeAmountPaid</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>DidTheFeeItemChange</name>
        <label>Did The Allocation Move From Another Fee Item?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Moved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forB_MovedFromAnotherItem</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetPriorFeeItem</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>After a payment allocation is added, or its amount or fee item changes, re-totals the fee it pays (and the fee it used to pay, if it moved) so the fee's Amount Paid and Status stay right. One sync per fee item per save.</description>
    <environments>Default</environments>
    <formulas>
        <name>forB_MovedFromAnotherItem</name>
        <description>True when an existing allocation was moved off a fee item, so that item's fee needs re-totalling too.</description>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNEW()) &amp;&amp; ISCHANGED({!$Record.FeeItem__c}) &amp;&amp; NOT(ISBLANK({!$Record__Prior.FeeItem__c}))</expression>
    </formulas>
    <interviewLabel>Record-Trigger: Payment Allocation After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Payment Allocation After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetItemFirstRecordInSameSave</name>
        <description>The fee item's first allocation in the same save, by Id. Only that record's run syncs, so a bulk save updates each fee once.</description>
        <label>Get Item First Record In Same Save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThisTheFirstRecordForTheItem</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FeeItem__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.FeeItem__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PaymentAllocation__c</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetPriorFeeItem</name>
        <label>Get Prior Fee Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SyncPriorFeeAmountPaid</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.FeeItem__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RegulatoryTrxnFeeItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetItemFirstRecordInSameSave</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.Amount__c}) || ISCHANGED({!$Record.FeeItem__c})</filterFormula>
        <object>PaymentAllocation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncFeeAmountPaid</name>
        <label>Sync Fee Amount Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>DidTheFeeItemChange</targetReference>
        </connector>
        <flowName>SubflowFeeAmountPaidSync</flowName>
        <inputAssignments>
            <name>varT_FeeId</name>
            <value>
                <elementReference>$Record.FeeItem__r.RegulatoryTrxnFeeId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SyncPriorFeeAmountPaid</name>
        <label>Sync Prior Fee Amount Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowFeeAmountPaidSync</flowName>
        <inputAssignments>
            <name>varT_FeeId</name>
            <value>
                <elementReference>GetPriorFeeItem.RegulatoryTrxnFeeId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
