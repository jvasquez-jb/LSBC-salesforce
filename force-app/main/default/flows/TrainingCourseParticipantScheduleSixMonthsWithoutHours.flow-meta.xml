<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>IsThisInTheWindow</name>
        <label>Is This In The Window?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>InWindow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forB_IsInWindow</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetHolderFirstRecord</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsThisTheHoldersFirstRecord</name>
        <label>Is This The Holder's First Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>First</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetHolderFirstRecord.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SyncStopCodes</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Nightly. Re-checks stop codes for students whose last hours were received 180 days ago in the last week. The sync uses the latest entry, so students with newer hours are unaffected. One sync per student. Continuing education attendance is not student hours and is skipped.</description>
    <environments>Default</environments>
    <formulas>
        <name>forB_IsInWindow</name>
        <description>True when the date this schedule watches fell in the last seven days.</description>
        <dataType>Boolean</dataType>
        <expression>{!$Record.ReceivedDate__c} &gt;= (TODAY() - 180) - 7 &amp;&amp; {!$Record.ReceivedDate__c} &lt; (TODAY() - 180)</expression>
    </formulas>
    <formulas>
        <name>forD_WindowStart</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 7</expression>
    </formulas>
    <formulas>
        <name>forD_WindowEnd</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>forDT_WindowStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY() - 7)</expression>
    </formulas>
    <formulas>
        <name>forDT_WindowEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>forD_LapseWindowStart</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(), -36) - 7</expression>
    </formulas>
    <formulas>
        <name>forD_LapseWindowEnd</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(), -36)</expression>
    </formulas>
    <formulas>
        <name>forDT_LapseWindowStart</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(ADDMONTHS(TODAY(), -36) - 7)</expression>
    </formulas>
    <formulas>
        <name>forDT_LapseWindowEnd</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(ADDMONTHS(TODAY(), -36))</expression>
    </formulas>
    <formulas>
        <name>forD_StaleWindowStart</name>
        <dataType>Date</dataType>
        <expression>(TODAY() - 180) - 7</expression>
    </formulas>
    <formulas>
        <name>forD_StaleWindowEnd</name>
        <dataType>Date</dataType>
        <expression>(TODAY() - 180)</expression>
    </formulas>
    <interviewLabel>Training Course Participant Schedule: Six Months Without Hours {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Training Course Participant Schedule: Six Months Without Hours</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHolderFirstRecord</name>
        <description>The holder's first matching record in the window. Only that record's run syncs, so a holder with several records gets one sync and no duplicate holds.</description>
        <label>Get Holder First Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThisTheHoldersFirstRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ReceivedDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>forD_StaleWindowStart</elementReference>
            </value>
        </filters>
        <filters>
            <field>ReceivedDate__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>forD_StaleWindowEnd</elementReference>
            </value>
        </filters>
        <filters>
            <field>EntryType__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Continuing Education</stringValue>
            </value>
        </filters>
        <filters>
            <field>EntryType__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Termination</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TrainingCourseParticipant</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsThisInTheWindow</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ReceivedDate__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>EntryType__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Continuing Education</stringValue>
            </value>
        </filters>
        <filters>
            <field>EntryType__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Termination</stringValue>
            </value>
        </filters>
        <object>TrainingCourseParticipant</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-10</startDate>
            <startTime>00:50:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncStopCodes</name>
        <label>Sync Stop Codes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.Contact.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
