    <description>Runs from the Record Complaint action on a Case. Staff confirm the complaint details (complaint type and incident date are pre-filled from the Case when the public complaint form set them), the establishment and practitioner it is about, and the complainant (pre-filled from the sender of the email or form). It creates a Public Complaint linked to the Case, adds the establishment, practitioner and known complainant as participants, sets the Case Type to Complaint, saves the confirmed complaint type and incident date on the Case, sets the Case's Account to the establishment (or practitioner) the complaint is about (so New Violation on the Case cites it; the complainant stays the Case's Contact), and moves the Case from the General Inquiries queue to Complaint Intake. A Case can have only one complaint. If any step fails, nothing is saved.</description>
    <dynamicChoiceSets>
        <name>pickChoice_ComplaintType</name>
        <dataType>Picklist</dataType>
        <picklistField>ComplaintType</picklistField>
        <picklistObject>PublicComplaint</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>pickChoice_ReporterCategory</name>
        <dataType>Picklist</dataType>
        <picklistField>ReporterCategory</picklistField>
        <picklistObject>PublicComplaint</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>forT_CaseAccountId</name>
        <description>The Case's new Account: the establishment the complaint is about, else the practitioner, else the Case's current Account.</description>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!forT_ComplaintAccountId}, {!GetCase.AccountId})</expression>
    </formulas>
    <formulas>
        <name>forB_AskedToStayConfidential</name>
        <description>True when the complaint came from the portal&apos;s File a Complaint form and the complainant asked to stay confidential: that form records the answer in the Case description. Pre-ticks Keep the complainant&apos;s identity confidential; staff can change it.</description>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!GetCase.Description}, &quot;Complainant asked to stay confidential: Yes&quot;)</expression>
    </formulas>
    <formulas>
        <name>forT_SenderName</name>
        <description>The sender's name from the Case, trimmed; blank when there is none.</description>
        <dataType>String</dataType>
        <expression>TRIM(BLANKVALUE({!GetCase.SuppliedName}, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>forT_FirstNameDefault</name>
        <description>First word of the sender's name, used to pre-fill First Name.</description>
        <dataType>String</dataType>
        <expression>IF(FIND(&quot; &quot;, {!forT_SenderName}) &gt; 0, LEFT({!forT_SenderName}, FIND(&quot; &quot;, {!forT_SenderName}) - 1), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>forT_LastNameDefault</name>
        <description>The rest of the sender's name after the first word (or the whole name if it is one word), used to pre-fill Last Name.</description>
        <dataType>String</dataType>
        <expression>IF(FIND(&quot; &quot;, {!forT_SenderName}) &gt; 0, MID({!forT_SenderName}, FIND(&quot; &quot;, {!forT_SenderName}) + 1, 80), {!forT_SenderName})</expression>
    </formulas>
    <formulas>
        <name>forD_ReceivedDate</name>
        <description>The date the Case came in.</description>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!GetCase.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>forT_ComplaintAccountId</name>
        <description>The account the complaint is about: the establishment if one is named, otherwise the practitioner.</description>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!RC_Establishment.recordId}, {!RC_Practitioner.recordId})</expression>
    </formulas>
    <formulas>
        <name>forT_NewOwnerId</name>
        <description>Complaint Intake when the Case sits in the General Inquiries queue; otherwise the Case keeps its owner.</description>
        <dataType>String</dataType>
        <expression>IF({!GetCase.OwnerId} = {!GetGeneralInquiriesQueue.Id} &amp;&amp; NOT(ISBLANK({!GetComplaintIntakeQueue.Id})), {!GetComplaintIntakeQueue.Id}, {!GetCase.OwnerId})</expression>
    </formulas>
