    <decisions>
        <name>DoesTheApplicantHaveBusinessApplications</name>
        <label>Does the Applicant Have Business Applications?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>GetFeesForMe</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>HasBusinessApplications</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varT_BusinessApplicationIds</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetFeesForMeAndMyBusinessApplications</targetReference>
