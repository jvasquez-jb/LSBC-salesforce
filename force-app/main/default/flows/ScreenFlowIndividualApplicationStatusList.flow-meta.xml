    <decisions>
        <name>IsThereAnApplicant</name>
        <label>Is the User Signed In as an Applicant?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>NotAnApplicant</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Applicant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetRunningUser.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetRunningUser.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetBusinessApplications</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhichListIsShown</name>
        <label>Which List Is Shown?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>GetIndividualApplications</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Applications</defaultConnectorLabel>
        <rules>
            <name>Fees</name>
            <conditionLogic>and</conditionLogic>
