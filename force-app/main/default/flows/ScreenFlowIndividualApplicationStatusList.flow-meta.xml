            <targetReference>LoopThroughBusinessApplications</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>BusinessApplicationShown</name>
            <conditionLogic>and</conditionLogic>
