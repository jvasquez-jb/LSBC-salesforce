        <defaultConnector>
            <targetReference>LoopThroughIndividualApplications</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>ApplicationShown</name>
            <conditionLogic>and</conditionLogic>
