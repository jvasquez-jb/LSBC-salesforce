    <description>Screen Flow: Individual Application Status List. Portal flow on My Applications and the Fees page. The page passes which list to show in List Name: Submitted (every application the signed-in applicant has sent to the Board, with its status), Returned (applications the Board has returned and not yet decided) or Fees (fees not yet paid in full). It lists the applicant&apos;s own applications (on their person account) and the business applications they filed, and for fees, the fees on their person account and on those business applications. Runs in system context because the portal license can&apos;t read business applications directly; every lookup is limited to the signed-in applicant&apos;s own person account and contact, and someone signed in without one (staff) sees only a log-in message. Shows a short message when the list is empty.</description>
    <environments>Default</environments>
    <formulas>
        <name>forB_IsFeesList</name>
        <dataType>Boolean</dataType>
        <expression>UPPER(TRIM({!varT_ListName})) = &quot;FEES&quot;</expression>
    </formulas>
    <formulas>
        <name>forB_IsReturnedList</name>
        <dataType>Boolean</dataType>
        <expression>UPPER(TRIM({!varT_ListName})) = &quot;RETURNED&quot;</expression>
    </formulas>
    <formulas>
        <name>forB_ApplicationReturned</name>
        <description>Returned to the applicant and not yet decided.</description>
        <dataType>Boolean</dataType>
        <expression>{!LoopThroughIndividualApplications.WasReturned} &amp;&amp; NOT(ISPICKVAL({!LoopThroughIndividualApplications.Status}, &quot;Approved&quot;)) &amp;&amp; NOT(ISPICKVAL({!LoopThroughIndividualApplications.Status}, &quot;Denied&quot;))</expression>
    </formulas>
    <formulas>
        <name>forB_ApplicationShown</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!forB_IsReturnedList}) || {!forB_ApplicationReturned}</expression>
    </formulas>
    <formulas>
        <name>forB_BusinessApplicationReturned</name>
        <description>Returned to the applicant and not yet decided.</description>
        <dataType>Boolean</dataType>
        <expression>{!LoopThroughBusinessApplications.WasReturned} &amp;&amp; NOT(ISPICKVAL({!LoopThroughBusinessApplications.Status}, &quot;Approved&quot;)) &amp;&amp; NOT(ISPICKVAL({!LoopThroughBusinessApplications.Status}, &quot;Approved with Conditions&quot;)) &amp;&amp; NOT(ISPICKVAL({!LoopThroughBusinessApplications.Status}, &quot;Canceled&quot;))</expression>
    </formulas>
    <formulas>
        <name>forB_BusinessApplicationShown</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!forB_IsReturnedList}) || {!forB_BusinessApplicationReturned}</expression>
    </formulas>
    <formulas>
        <name>forD_ApplicationSubmitted</name>
        <description>The date in Louisiana (Central time, UTC-6; up to an hour off near midnight in daylight time). Applications entered by staff may have no applied date: the created date is used.</description>
        <dataType>Date</dataType>
        <expression>DATEVALUE(BLANKVALUE({!LoopThroughIndividualApplications.AppliedDate}, {!LoopThroughIndividualApplications.CreatedDate}) - 6/24)</expression>
    </formulas>
    <formulas>
        <name>forD_BusinessApplicationSubmitted</name>
        <description>The date in Louisiana (Central time, UTC-6; up to an hour off near midnight in daylight time). Applications entered by staff may have no applied date: the created date is used.</description>
        <dataType>Date</dataType>
        <expression>DATEVALUE(BLANKVALUE({!LoopThroughBusinessApplications.AppliedDate}, {!LoopThroughBusinessApplications.CreatedDate}) - 6/24)</expression>
    </formulas>
    <formulas>
        <name>forD_FeeDue</name>
        <description>The date in Louisiana (Central time, UTC-6).</description>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!LoopThroughFees.DueDate} - 6/24)</expression>
    </formulas>
    <formulas>
        <name>forT_ApplicationRow</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; &quot;&lt;b&gt;&quot; &amp; {!LoopThroughIndividualApplications.LicenseType.Name} &amp; IF(ISPICKVAL({!LoopThroughIndividualApplications.ApplicationType}, &quot;&quot;), &quot;&quot;, &quot;: &quot; &amp; TEXT({!LoopThroughIndividualApplications.ApplicationType})) &amp; &quot;&lt;/b&gt;&quot; &amp; &quot;&lt;br&gt;&quot; &amp; {!LoopThroughIndividualApplications.Name} &amp; &quot;&lt;/td&gt;&quot; &amp; IF({!forB_IsReturnedList}, &quot;&quot;, &quot;&lt;td&gt;&quot; &amp; IF({!forB_ApplicationReturned}, &quot;Returned to you&quot;, TEXT({!LoopThroughIndividualApplications.Status})) &amp; &quot;&lt;/td&gt;&quot;) &amp; &quot;&lt;td&gt;&quot; &amp; TEXT(MONTH({!forD_ApplicationSubmitted})) &amp; &quot;/&quot; &amp; TEXT(DAY({!forD_ApplicationSubmitted})) &amp; &quot;/&quot; &amp; TEXT(YEAR({!forD_ApplicationSubmitted})) &amp; &quot;&lt;/td&gt;&quot; &amp; IF({!forB_IsReturnedList}, &quot;&lt;td&gt;&quot; &amp; BLANKVALUE(TEXT({!LoopThroughIndividualApplications.ReturnReason__c}), &quot;See the Board&apos;s letter&quot;) &amp; &quot;&lt;/td&gt;&quot;, &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_BusinessApplicationRow</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; &quot;&lt;b&gt;&quot; &amp; {!LoopThroughBusinessApplications.LicenseType.Name} &amp; IF(ISPICKVAL({!LoopThroughBusinessApplications.ApplicationType}, &quot;&quot;), &quot;&quot;, &quot;: &quot; &amp; TEXT({!LoopThroughBusinessApplications.ApplicationType})) &amp; &quot;&lt;/b&gt;&quot; &amp; IF(ISBLANK({!LoopThroughBusinessApplications.Account.Name}), &quot;&quot;, &quot; (&quot; &amp; SUBSTITUTE({!LoopThroughBusinessApplications.Account.Name}, &quot;&lt;&quot;, &quot;&amp;lt;&quot;) &amp; &quot;)&quot;) &amp; &quot;&lt;br&gt;&quot; &amp; {!LoopThroughBusinessApplications.Name} &amp; &quot;&lt;/td&gt;&quot; &amp; IF({!forB_IsReturnedList}, &quot;&quot;, &quot;&lt;td&gt;&quot; &amp; IF({!forB_BusinessApplicationReturned}, &quot;Returned to you&quot;, TEXT({!LoopThroughBusinessApplications.Status})) &amp; &quot;&lt;/td&gt;&quot;) &amp; &quot;&lt;td&gt;&quot; &amp; TEXT(MONTH({!forD_BusinessApplicationSubmitted})) &amp; &quot;/&quot; &amp; TEXT(DAY({!forD_BusinessApplicationSubmitted})) &amp; &quot;/&quot; &amp; TEXT(YEAR({!forD_BusinessApplicationSubmitted})) &amp; &quot;&lt;/td&gt;&quot; &amp; IF({!forB_IsReturnedList}, &quot;&lt;td&gt;&quot; &amp; BLANKVALUE(TEXT({!LoopThroughBusinessApplications.ReturnReason__c}), &quot;See the Board&apos;s letter&quot;) &amp; &quot;&lt;/td&gt;&quot;, &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_ApplicationsHeader</name>
        <dataType>String</dataType>
        <expression>IF({!forB_IsReturnedList}, &quot;&lt;p&gt;The Board has sent these applications back to you. Upload what the Board asks for under &lt;b&gt;Documents to upload&lt;/b&gt; on this page, or follow the Board&apos;s letter. The Board then reviews the application again.&lt;/p&gt;&quot;, &quot;&lt;p&gt;Applications you have sent to the Board and where each one stands. Business applications are listed after your own.&lt;/p&gt;&quot;) &amp; &quot;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Application&lt;/th&gt;&quot; &amp; IF({!forB_IsReturnedList}, &quot;&lt;th&gt;Submitted&lt;/th&gt;&lt;th&gt;Reason&lt;/th&gt;&quot;, &quot;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Submitted&lt;/th&gt;&quot;) &amp; &quot;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_NoApplicationsMessage</name>
        <dataType>String</dataType>
        <expression>IF({!forB_IsReturnedList}, &quot;&lt;p&gt;None of your applications has been returned to you.&lt;/p&gt;&quot;, &quot;&lt;p&gt;You have not submitted any applications yet. Applications you submit appear here with their status.&lt;/p&gt;&quot;)</expression>
    </formulas>
    <formulas>
        <name>forC_FeeBalance</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!LoopThroughFees.TotalFeeAmount}, 0) - BLANKVALUE({!LoopThroughFees.AmountPaid__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>forT_FeeRow</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; BLANKVALUE({!LoopThroughFees.Description}, &quot;Fee&quot;) &amp; &quot;&lt;br&gt;&quot; &amp; {!LoopThroughFees.Name} &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; &quot;$&quot; &amp; IF(FLOOR(BLANKVALUE({!LoopThroughFees.TotalFeeAmount}, 0)) &gt;= 1000, TEXT(FLOOR(FLOOR(BLANKVALUE({!LoopThroughFees.TotalFeeAmount}, 0)) / 1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;00&quot; &amp; TEXT(MOD(FLOOR(BLANKVALUE({!LoopThroughFees.TotalFeeAmount}, 0)), 1000)), 3), TEXT(FLOOR(BLANKVALUE({!LoopThroughFees.TotalFeeAmount}, 0)))) &amp; &quot;.&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(ROUND((BLANKVALUE({!LoopThroughFees.TotalFeeAmount}, 0) - FLOOR(BLANKVALUE({!LoopThroughFees.TotalFeeAmount}, 0))) * 100, 0)), 2) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; IF(TEXT({!LoopThroughFees.Status}) = &quot;PARTIALLY_PAID&quot;, &quot;Partly paid, &quot; &amp; &quot;$&quot; &amp; IF(FLOOR({!forC_FeeBalance}) &gt;= 1000, TEXT(FLOOR(FLOOR({!forC_FeeBalance}) / 1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;00&quot; &amp; TEXT(MOD(FLOOR({!forC_FeeBalance}), 1000)), 3), TEXT(FLOOR({!forC_FeeBalance}))) &amp; &quot;.&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(ROUND(({!forC_FeeBalance} - FLOOR({!forC_FeeBalance})) * 100, 0)), 2) &amp; &quot; still to pay&quot;, CASE(TEXT({!LoopThroughFees.Status}), &quot;DUE&quot;, &quot;Due&quot;, TEXT({!LoopThroughFees.Status}))) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; IF(ISBLANK({!LoopThroughFees.DueDate}), &quot;&quot;, TEXT(MONTH({!forD_FeeDue})) &amp; &quot;/&quot; &amp; TEXT(DAY({!forD_FeeDue})) &amp; &quot;/&quot; &amp; TEXT(YEAR({!forD_FeeDue}))) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_TotalToPay</name>
        <dataType>String</dataType>
        <expression>&quot;$&quot; &amp; IF(FLOOR({!varC_TotalToPay}) &gt;= 1000, TEXT(FLOOR(FLOOR({!varC_TotalToPay}) / 1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;00&quot; &amp; TEXT(MOD(FLOOR({!varC_TotalToPay}), 1000)), 3), TEXT(FLOOR({!varC_TotalToPay}))) &amp; &quot;.&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(ROUND(({!varC_TotalToPay} - FLOOR({!varC_TotalToPay})) * 100, 0)), 2)</expression>
    </formulas>
    <interviewLabel>Screen Flow: Individual Application Status List {!$Flow.CurrentDateTime}</interviewLabel>
    <label>My Applications List</label>
    <loops>
        <name>LoopThroughIndividualApplications</name>
        <label>Loop Through Individual Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetIndividualApplications</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>IsTheApplicationOnThisList</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>LoopThroughBusinessApplications</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopThroughBusinessApplications</name>
        <label>Loop Through Business Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetBusinessApplications</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>IsTheBusinessApplicationOnThisList</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>AreThereApplications</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopThroughBusinessApplicationsForFees</name>
        <label>Loop Through Business Applications for Fees</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetBusinessApplications</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddBusinessApplicationId</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>DoesTheApplicantHaveBusinessApplications</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopThroughFees</name>
        <label>Loop Through Fees</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varR_Fees</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddFeeRow</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>AreThereFees</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
