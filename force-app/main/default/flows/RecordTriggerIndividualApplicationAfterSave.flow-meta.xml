<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>After an application is created, or its status, record type, license type or applicant changes, re-checks automatic stop codes for the applicant. An open licensure application is what makes hours and examination codes apply.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Individual Application After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Individual Application After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SyncStopCodes</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.Status}) || ISCHANGED({!$Record.RecordTypeId}) || ISCHANGED({!$Record.LicenseTypeId}) || ISCHANGED({!$Record.AccountId})</filterFormula>
        <object>IndividualApplication</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncStopCodes</name>
        <label>Sync Stop Codes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
