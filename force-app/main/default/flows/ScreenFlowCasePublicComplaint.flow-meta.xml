<Flow xmlns="http://soap.sforce.com/2006/04/metadata"><apiVersion>66.0</apiVersion><description>The public complaint form on the portal, open to guests. Creates a Case with Origin Web and Type Complaint in the Complaint Intake queue, where staff triage it with Record Complaint. The complainant may stay anonymous. Runs in system context because guests have no record access.</description><dynamicChoiceSets><name>choice_ComplaintType</name><dataType>Picklist</dataType><displayField xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/><object xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/><picklistField>ComplaintType</picklistField><picklistObject>PublicComplaint</picklistObject></dynamicChoiceSets><environments>Default</environments><formulas><name>forT_Subject</name><dataType>String</dataType><expression>LEFT(&quot;Complaint: &quot; &amp; TRIM({!C_About}), 255)</expression></formulas><formulas><name>forT_Description</name><description>Everything the complainant entered, for staff triage.</description><dataType>String</dataType><expression>&quot;About: &quot; &amp; TRIM({!C_About}) &amp; IF(ISBLANK({!C_AboutAddress}), &quot;&quot;, &quot;, &quot; &amp; TRIM({!C_AboutAddress})) &amp; BR() &amp; &quot;Type: &quot; &amp; {!C_ComplaintType} &amp; BR() &amp; &quot;Date it happened: &quot; &amp; IF(ISBLANK({!C_IncidentDate}), &quot;not given&quot;, TEXT({!C_IncidentDate})) &amp; BR() &amp; &quot;Complainant asked to stay confidential: &quot; &amp; IF({!C_Confidential}, &quot;Yes&quot;, &quot;No&quot;) &amp; BR() &amp; BR() &amp; {!C_Description}</expression></formulas><interviewLabel>Screen Flow: Case Public Complaint {!$Flow.CurrentDateTime}</interviewLabel><label>Screen Flow: Case Public Complaint</label><processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></