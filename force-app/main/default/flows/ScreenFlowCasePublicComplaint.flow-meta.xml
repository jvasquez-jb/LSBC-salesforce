<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata"><apiVersion>66.0</apiVersion><assignments><name>SetCertificationOutputs</name><label>Set Certification Outputs</label><locationX>0</locationX><locationY>0</locationY><assignmentItems><assignToReference>varB_IsCertified</assignToReference><operator>Assign</operator><value><elementReference>C_Certify</elementReference></value></assignmentItems><assignmentItems><assignToReference>varT_CertifiedName</assignToReference><operator>Assign</operator><value><elementReference>forT_TypedName</elementReference></value></assignmentItems><assignmentItems><assignToReference>varDT_CertifiedDateTime</assignToReference><operator>Assign</operator><value><elementReference>$Flow.CurrentDateTime</elementReference></value></assignmentItems><connector><targetReference>GetComplaintIntakeQueue</targetReference></connector></assignments><description>Portal flow (Screen Flow: Case Public Complaint). The public complaint form on the portal, open to guests. Creates a Case with Origin Web and Type Complaint in the Complaint Intake queue, with the complaint type and incident date in their own Case fields and in the Description, where staff triage it with Record Complaint. Complaints must be signed: the complainant gives their name and email and certifies the complaint with the same certification wording as the licence forms (checkbox and typed name, without Save for later, since guests can't come back to a saved form), and the certification is added to the Case description. Runs in system context because guests have no record access.</description><dynamicChoiceSets><name>choice_ComplaintType</name><dataType>Picklist</dataType><displayField xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/><object xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/><picklistField>ComplaintType</picklistField><picklistObject>PublicComplaint</picklistObject></dynamicChoiceSets><environments>Default</environments><formulas><name>forDT_CertifiedLouisiana</name><description>When the applicant certified, moved from GMT to Louisiana (Central) time, daylight saving included. Only for display.</description><dataType>DateTime</dataType><expression>{!varDT_CertifiedDateTime} - IF(AND({!varDT_CertifiedDateTime} &gt;= DATETIMEVALUE(TEXT((DATE(YEAR(DATEVALUE({!varDT_CertifiedDateTime})), 3, 8) + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!varDT_CertifiedDateTime})), 3, 8)), 7))) &amp; " 08:00:00"), {!varDT_CertifiedDateTime} &lt; DATETIMEVALUE(TEXT((DATE(YEAR(DATEVALUE({!varDT_CertifiedDateTime})), 11, 1) + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!varDT_CertifiedDateTime})), 11, 1)), 7))) &amp; " 07:00:00")), 5, 6) / 24</expression></formulas><formulas><name>forT_CertifiedLouisianaTime</name><description>When the applicant certified, in Louisiana time, for example November 19, 2026 at 9:54 PM.</description><dataType>String</dataType><expression>CASE(VALUE(MID(TEXT({!forDT_CertifiedLouisiana}), 6, 2)), 1, "January", 2, "February", 3, "March", 4, "April", 5, "May", 6, "June", 7, "July", 8, "August", 9, "September", 10, "October", 11, "November", 12, "December", "") &amp; " " &amp; TEXT(VALUE(MID(TEXT({!forDT_CertifiedLouisiana}), 9, 2))) &amp; ", " &amp; LEFT(TEXT({!forDT_CertifiedLouisiana}), 4) &amp; " at " &amp; TEXT(MOD(VALUE(MID(TEXT({!forDT_CertifiedLouisiana}), 12, 2)) + 11, 12) + 1) &amp; ":" &amp; MID(TEXT({!forDT_CertifiedLouisiana}), 15, 2) &amp; " " &amp; IF(VALUE(MID(TEXT({!forDT_CertifiedLouisiana}), 12, 2)) &lt; 12, "AM", "PM")</expression></formulas><formulas><name>forT_TypedName</name><description>The name the complainant typed to sign, trimmed.</description><dataType>String</dataType><expression>TRIM({!C_TypedName})</expression></formulas><formulas><name>forT_Subject</name><dataType>String</dataType><expression>LEFT(&quot;Complaint: &quot; &amp; TRIM({!C_About}), 255)</expression></formulas><formulas><name>forT_Description</name><description>Everything the complainant entered and their certification, for staff triage.</description><dataType>String</dataType><expression>&quot;About: &quot; &amp; TRIM({!C_About}) &amp; IF(ISBLANK({!C_AboutAddress}), &quot;&quot;, &quot;, &quot; &amp; TRIM({!C_AboutAddress})) &amp; BR() &amp; &quot;Type: &quot; &amp; {!C_ComplaintType} &amp; BR() &amp; &quot;Date it happened: &quot; &amp; IF(ISBLANK({!C_IncidentDate}), &quot;not given&quot;, TEXT(MONTH({!C_IncidentDate})) &amp; &quot;/&quot; &amp; TEXT(DAY({!C_IncidentDate})) &amp; &quot;/&quot; &amp; TEXT(YEAR({!C_IncidentDate}))) &amp; BR() &amp; BR() &amp; {!C_Description} &amp; BR() &amp; BR() &amp; &quot;Certified by &quot; &amp; {!varT_CertifiedName} &amp; &quot; on &quot; &amp; {!forT_CertifiedLouisianaTime} &amp; &quot; (Louisiana time).&quot;</expression></formulas><interviewLabel>Screen Flow: Case Public Complaint {!$Flow.CurrentDateTime}</interviewLabel><isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun><label>File a Complaint</label><processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues><processMetadataValues><name>OriginBuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processType>Flow</processType><recordCreates><name>CreateComplaintCase</name><label>Create Complaint Case</label><locationX>0</locationX><locationY>0</locationY><connector><targetReference>GetCreatedCase</targetReference></connector><faultConnector><targetReference>CouldNotSubmit</targetReference></faultConnector><inputAssignments><field>Origin</field><value><stringValue>Web</stringValue></value></inputAssignments><inputAssignments><field>Type</field><value><stringValue>Complaint</stringValue></value></inputAssignments><inputAssignments><field>Subject</field><value><elementReference>forT_Subject</elementReference></value></inputAssignments><inputAssignments><field>ComplaintType__c</field><value><elementReference>C_ComplaintType</elementReference></value></inputAssignments><inputAssignments><field>IncidentDate__c</field><value><elementReference>C_IncidentDate</elementReference></value></inputAssignments><inputAssignments><field>Description</field><value><elementReference>forT_Description</elementReference></value></inputAssignments><inputAssignments><field>SuppliedName</field><value><elementReference>C_YourName</elementReference></value></inputAssignments><inputAssignments><field>SuppliedEmail</field><value><elementReference>C_YourEmail</elementReference></value></inputAssignments><inputAssignments><field>SuppliedPhone</field><value><elementReference>C_YourPhone</elementReference></value></inputAssignments><inputAssignments><field>OwnerId</field><value><elementReference>GetComplaintIntakeQueue.Id</elementReference></value></inputAssignments><object>Case</object><storeOutputAutomatically>true</storeOutputAutomatically></recordCreates><recordLookups><name>GetComplaintIntakeQueue</name><label>Get Complaint Intake Queue</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>CreateComplaintCase</targetReference></connector><filterLogic>and</filterLogic><filters><field>DeveloperName</field><operator>EqualTo</operator><value><stringValue>ComplaintIntake</stringValue></value></filters><filters><field>Type</field><operator>EqualTo</operator><value><stringValue>Queue</stringValue></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>Group</object><queriedFields>Id</queriedFields><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups><recordLookups><name>GetCreatedCase</name><label>Get Created Case</label><locationX>0</locationX><locationY>0</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Submitted</targetReference></connector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>CreateComplaintCase</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>Case</object><queriedFields>Id</queriedFields><queriedFields>CaseNumber</queriedFields><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups><runInMode>SystemModeWithoutSharing</runInMode><screens><name>Certification</name><label>Certification</label><locationX>0</locationX><locationY>0</locationY><allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause><connector><targetReference>SetCertificationOutputs</targetReference></connector><fields><name>C_Certify</name><dataType>Boolean</dataType><fieldText>I certify that all the information I have provided is true and correct.</fieldText><fieldType>InputField</fieldType><isRequired>true</isRequired><validationRule><errorMessage>Tick the box to certify the complaint.</errorMessage><formulaExpression>{!C_Certify} = true</formulaExpression></validationRule></fields><fields><name>C_TypedName</name><dataType>String</dataType><defaultValue><elementReference>C_YourName</elementReference></defaultValue><fieldText>Type your full name</fieldText><fieldType>InputField</fieldType><helpText>Typing your name has the same effect as signing a paper complaint.</helpText><isRequired>true</isRequired><validationRule><errorMessage>Type your full name.</errorMessage><formulaExpression>LEN(TRIM({!C_TypedName})) &gt; 1</formulaExpression></validationRule></fields><nextOrFinishButtonLabel>Certify</nextOrFinishButtonLabel><showFooter>true</showFooter><showHeader>false</showHeader></screens><screens><name>Complaint</name><label>File a Complaint</label><locationX>0</locationX><locationY>0</locationY><allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause><connector><targetReference>Certification</targetReference