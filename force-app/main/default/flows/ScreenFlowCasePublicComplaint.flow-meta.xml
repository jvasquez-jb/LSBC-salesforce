>Address or city</fieldText><fieldType>InputField</fieldType><isRequired>false</isRequired></fields><fields><name>C_ComplaintType</name><choiceReferences>choice_ComplaintType</choiceReferences><dataType>String</dataType><fieldText>Type of complaint</fieldText><fieldType>DropdownBox</fieldType><isRequired>true</isRequired></fields><fields><name>C_IncidentDate</name><dataType>Date</dataType><fieldText>Date it happened</fieldText><fieldType>InputField</fieldType><isRequired>false</isRequired><validationRule><errorMessage>The date can&apos;t be in the future.</errorMessage><formulaExpression>{!C_IncidentDate} &lt;= {!$Flow.CurrentDate}</formulaExpression></validationRule></fields><fields><name>C_Description</name><fieldText>What happened?</fieldText><fieldType>LargeTextArea</fieldType><isRequired>true</isRequired></fields><fields><name>C_YouHeading</name><fieldText>&lt;h2&gt;Your details (optional)&lt;/h2&gt;</fieldText><fieldType>DisplayText</fieldType></fields><fields><name>C_YourName</name><dataType>String</dataType><fieldText>Your name</fieldText><fieldType>InputField</fieldType><isRequired>false</isRequired></fields><fields><name>C_YourEmail</name><dataType>String</dataType><fieldText>Your email</fieldText><fieldType>InputField</fieldType><isRequired>false</isRequired><validationRule><errorMessage>Enter a valid email address.</errorMessage><formulaExpression>OR(ISBLANK({!C_YourEmail}), REGEX({!C_YourEmail}, &quot;[^@\\s]+@[^@\\s]+\\.[^@\\s]+&quot;))</formulaExpression></validationRule></fields><fields><name>C_YourPhone</name><dataType>String</dataType><fieldText>Your phone</fieldText><fieldType>InputField</fieldType><isRequired>false</isRequired></fields><fields><name>C_Confidential</name><dataType>Boolean</dataType><fieldText>Keep my name confidential.</fieldText><fieldType>InputField</fieldType><isRequired>true</isRequired></fields><nextOrFinishButtonLabel>Submit complaint</nextOrFinishButtonLabel><showFooter>true</showFooter><showHeader>false</showHeader></scree