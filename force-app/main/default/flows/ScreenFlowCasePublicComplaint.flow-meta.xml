isRequired>true</isRequired><validationRule><errorMessage>Enter a valid email address.</errorMessage><formulaExpression>OR(ISBLANK({!C_YourEmail}), REGEX({!C_YourEmail}, &quot;[^@\\s]+@[^@\\s]+\\.[^@\\s]+&quot;))</formulaExpression></validationRule></fields><fields><name>C_YourPhone</name><dataType>String</dataType><fieldText>Your phone</fieldText><fieldType>InputField</fieldType><isRequired>false</isRequired></fields><nextOrFinishButtonLabel>Next</nextOrFinishButtonLabel><showFooter>true</showFooter><showHeader>false</showHeader></screens><screens><name>Submitted</name><label>Complaint Submitted</label><locationX>0</locationX><locationY>0</locationY><allowBack>false</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause><fields><name>SUB_Message</name><fieldText>&lt;p&gt;Thank you. Your complaint has been sent to the Board.&lt;/p&gt;&lt;p&gt;Your reference number is &lt;b&gt;{!GetCreatedCase.CaseNumber}&lt;/b&gt;. Quote it if you contact the Board about this complaint.&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><fields><name>SUB_BackToHome</name><fieldText>&lt;p&gt;&lt;a class=&quot;lsbc-button&quot; target=&quot;_self&quot; href=&quot;/LPI/s/&quot;&gt;Back to Home&lt;/a&gt;&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><showFooter>false</showFooter><showHeader>false</showHeader></screens><screens><name>CouldNotSubmit</name><label>Could Not Submit</label><locationX>0</locationX><locationY>0</locationY><allowBack>false</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause><fields><name>CNS_Message</name><fieldText>&lt;p&gt;Sorry, your complaint could not be sent. Please try again, or call the Board at 225-756-3404.&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><fields><name>CNS_BackToHome</name><fieldText>&lt;p&gt;&lt;a class=&quot;lsbc-button&quot; target=&quot;_self&quot; href=&quot;/LPI/s/&quot;&gt;Back to Home&lt;/a&gt;&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><showFooter>false</showFooter><showHeader>false</showHeader></screens><start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>Complaint</targetReference></connector></start><status>Active</status><variables><name>varB_IsCertified</name><description>Whether the applicant ticked the certification.</description><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables><variables><name>varDT_CertifiedDateTime</name><description>When the applicant certified.</description><dataType>DateTime</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables><variables><name>varT_CertifiedName</name><description>The name the applicant typed to certify.</description><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables></Flow>
