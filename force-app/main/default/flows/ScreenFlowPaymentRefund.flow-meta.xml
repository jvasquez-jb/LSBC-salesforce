d once the check is issued.&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><fields><name>RR_Amount</name><dataType>Currency</dataType><defaultValue><elementReference>forC_Refundable</elementReference></defaultValue><fieldText>Refund amount</fieldText><fieldType>InputField</fieldType><isRequired>true</isRequired><scale>2</scale><validationRule><errorMessage>The refund must be more than zero and can't be more than the unapplied amount.</errorMessage><formulaExpression>{!RR_Amount} &gt; 0 &amp;&amp; {!RR_Amount} &lt;= {!forC_Refundable}</formulaExpression></validationRule></fields><fields><name>RR_Department</name><dataType>String</dataType><fieldText>Requested by (department)</fieldText><fieldType>InputField</fieldType><helpText>The department asking for the refund, for example Front Desk or Renewals.</helpText><isRequired>true</isRequired></fields><nextOrFinishButtonLabel>Request Refund</nextOrFinishButtonLabel><showFooter>true</showFooter><showHeader>false</showHeader></screens><screens><name>VerifyRefund</name><label>Verify Refund</label><locationX>0</locationX><locationY>0</locationY><allowBack>false</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause><connector><targetReference>VerifyOrCancel</targetReference></connector><fields><name>VR_Request</name><fieldText>&lt;p&gt;Refund of &lt;b&gt;{!forC_RefundAmount}&lt;/b&gt; from payment {!GetPayment.Name}, requested by {!GetPayment.RefundRequestedBy__c} on {!GetPayment.RefundRequestedDate__c}.&lt;/p&gt;&lt;p&gt;Check the signed request form, then verify it or cancel it.&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><fields><name>VR_Decision</name><choiceReferences>choice_Verify</choiceReferences><choiceReferences>choice_Cancel</choiceReferences><dataType>String</dataType><fieldText>Decision</fieldText><fieldType>RadioButtons</fieldType><isRequired>true</isRequired></fields><showFooter>true</showFooter><showHeader>false</showHeader></screens><screens><name>EnterRe