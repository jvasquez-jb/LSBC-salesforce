    <decisions>
        <name>IsTheRenewalFeeScheduled</name>
        <label>Is The Renewal Fee In The Fee Schedule?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetProblemMessage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LookUpRenewalFee.Amount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LookUpLatePenalty</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsThisALateSchoolRenewal</name>
        <label>Is This A Late School Renewal?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>SetLateFeeStart</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>LateSchool</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forB_IsSchool</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RunFeeLateCalculation.DelinquentYears</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetFailureToRenewItemFields</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>AreThereMoreLateYears</name>
        <label>Are There More Late Years?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>IsARestorationExamNeeded</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>MoreYears</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varN_YearIndex</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>RunFeeLateCalculation.DelinquentYears</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varC_LateFeeRemaining</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetLateFeeItemFields</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsARestorationExamNeeded</name>
        <label>Is A Restoration Exam Needed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CreateFeeItems</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>ExamNeeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RunFeeLateCalculation.RequiresRestorationExam</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetRestorationItemFields</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Raises the fee for renewing one license: the renewal, a late fee for each missed license year up to the cap (or the failure-to-renew fee for a late school), and the restoration exam fee when needed. Amounts come from the Fee Schedule. The fee is filed under the renewal application when one is given, otherwise under the license.</description>
    <environments>Default</environments>
    <formulas>
        <name>forT_RenewalItemName</name>
        <description>The renewal item&apos;s name, with the license type, so a renewal of several licenses lists each one (Cosmetologist renewal).</description>
        <dataType>String</dataType>
        <expression>{!GetLicenseType.Name} &amp; &quot; renewal&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_LateFeeItemName</name>
        <description>The late fee item&apos;s name, with the license type (Cosmetologist late fee).</description>
        <dataType>String</dataType>
        <expression>{!GetLicenseType.Name} &amp; &quot; late fee&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_RenewalCalculationInfo</name>
        <description>How the renewal item was priced, worded for the case: a late school also pays the failure-to-renew fee.</description>
        <dataType>String</dataType>
        <expression>IF({!forB_IsSchool} &amp;&amp; {!RunFeeLateCalculation.DelinquentYears} &gt; 0, &quot;Renewal from the Fee Schedule. The school renewed late, so the failure-to-renew fee is charged as well.&quot;, &quot;Renewal from the Fee Schedule.&quot;)</expression>
    </formulas>
    <formulas>
        <name>forT_FeeParentId</name>
        <description>The record the fee belongs to: the renewal application when one is given, otherwise the license.</description>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!varT_ApplicationId}, {!GetBusinessLicense.Id})</expression>
    </formulas>
    <formulas>
        <name>forD_AsOfDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!varD_AsOfDate}), TODAY(), {!varD_AsOfDate})</expression>
    </formulas>
    <formulas>
        <name>forD_PaidThroughDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!GetBusinessLicense.PeriodEnd})</expression>
    </formulas>
    <formulas>
        <name>forB_IsSchool</name>
        <dataType>Boolean</dataType>
        <expression>{!GetLicenseType.Name} = &quot;School&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_RenewalFeeName</name>
        <description>Which Fee Schedule row prices this renewal: the license type's name followed by Renewal, such as Cosmetologist Renewal. A type with no row stops the assessment with a message.</description>
        <dataType>String</dataType>
        <expression>{!GetLicenseType.Name} &amp; &quot; Renewal&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_LateFeeName</name>
        <description>Which Fee Schedule row prices each missed license year: the license type's name followed by Late Fee, such as Cosmetologist Late Fee. A late school pays the failure-to-renew fee instead.</description>
        <dataType>String</dataType>
        <expression>{!GetLicenseType.Name} &amp; &quot; Late Fee&quot;</expression>
    </formulas>
    <formulas>
        <name>forT_RenewalYear</name>
        <description>The license year this renewal pays for.</description>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!forD_PaidThroughDate}) + MAX({!RunFeeLateCalculation.DelinquentYears} - 1, 0))</expression>
    </formulas>
    <formulas>
        <name>forN_FirstLateYear</name>
        <description>The first missed license year.</description>
        <dataType>Number</dataType>
        <expression>YEAR({!forD_PaidThroughDate})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>forT_LateFeeYear</name>
        <dataType>String</dataType>
        <expression>TEXT({!varN_LateFeeYear})</expression>
    </formulas>
    <formulas>
        <name>forC_ThisLateFee</name>
        <description>The late fee for this year, reduced if the cap is reached.</description>
        <dataType>Currency</dataType>
        <expression>MIN({!LookUpLatePenalty.Amount}, {!varC_LateFeeRemaining})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>forT_ProblemMessage</name>
        <dataType>String</dataType>
        <expression>&quot;No amount for &quot; &amp; {!forT_RenewalFeeName} &amp; &quot; in the Fee Schedule, so no fee was created.&quot;</expression>
    </formulas>
