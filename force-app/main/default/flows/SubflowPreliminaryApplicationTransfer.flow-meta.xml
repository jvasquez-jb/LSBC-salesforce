<Flow xmlns="http://soap.sforce.com/2006/04/metadata"><apiVersion>66.0</apiVersion><description>Called when a portal application is submitted. Moves the checklist items (and the files on them) from the draft, a Preliminary Application Reference, to the real application, and marks the draft submitted. Until submit, a portal form keeps its documents on the draft so that nothing appears on Individual Application until the applicant certifies. The form deletes the draft once payment is done; until then the draft lets the applicant resume the payment step from My Applications.</description><environments>Default</environments><interviewLabel>Subflow: Preliminary Application Transfer {!$Flow.CurrentDateTime}</interviewLabel><label>Subflow: Preliminary Application Transfer</label><processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues><processMetadataValues><name>OriginBuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues><processType>AutoLaunchedFlow</processType><recordUpdates><name>MoveChecklistItems</name><label>Move Checklist Items to the Application</label><locationX>0</locationX><locationY>0</locationY><connector><targetReference>MarkDraftSubmitted</targetReference></connector><filterLogic>and</filterLogic><filters><field>ParentRecordId</field><operator>EqualTo</operator><value><elementReference>varT_PreliminaryApplicationId</elementReference></value></filters><inputAssignments><field>ParentRecordId</field><value><elementReference>varT_ApplicationId</elementReference></value></inputAssignments><object>DocumentChecklistItem</object></recordUpdates><recordUpdates><name>MarkDraftSubmitted</name><label>Mark Draft Submitted</label><locationX>0</locationX><locationY>0</locationY><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>varT_PreliminaryApplicationId</elementReference></value></filters><inputAssignments><field>IsSubmitted</field><value><booleanValue>true</booleanValue></value></inputAssignments><object>PreliminaryApplicationRef</object></recordUpdates><runInMode>SystemModeWithoutSharing</runInMode><start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>MoveChecklistItems</targetReference></connector></start><status>Active</status><variables><name>varT_PreliminaryApplicationId</name><description>The draft (Preliminary Application Reference).</description><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables><variables><name>varT_ApplicationId</name><description>The application the documents move to.</description><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables></Flow>
