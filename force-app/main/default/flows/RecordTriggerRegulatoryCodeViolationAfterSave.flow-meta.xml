<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>LookUpViolationFee</name>
        <label>Look Up Violation Fee</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>FeeSchedule</actionName>
        <actionType>runDecisionMatrix</actionType>
        <connector>
            <targetReference>IsTheViolationFeeScheduled</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>FeeName</name>
            <value>
                <stringValue>Violation</stringValue>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <customErrors>
        <name>ViolationFeeNotScheduled</name>
        <description>Stops the save when the Fee Schedule has no Violation amount, so no violation is recorded without its fee.</description>
        <label>Violation Fee Not Scheduled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The violation fee is missing from the Fee Schedule, so the violation can&apos;t be recorded. Ask an admin to add a Violation row to the Fee Schedule decision matrix.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>IsTheViolationFeeScheduled</name>
        <label>Is The Violation Fee In The Fee Schedule?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>ViolationFeeNotScheduled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LookUpViolationFee.Amount</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetViolationProduct</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>When a violation is recorded, raises its fee from the Fee Schedule against the cited party (the establishment or the practitioner), due 15 days after the violation date, and records that due date on the violation. If the fee is still unpaid after the due date, the existing stop code rules open the non-payment hold on the cited party.</description>
    <environments>Default</environments>
    <formulas>
        <name>forDT_DueDate</name>
        <description>15 days after the violation date.</description>
        <dataType>DateTime</dataType>
        <expression>{!$Record.DateCreated} + 15</expression>
    </formulas>
    <formulas>
        <name>forT_ForYear</name>
        <description>The year of the violation, as the license year the fee item applies to.</description>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(DATEVALUE({!$Record.DateCreated})))</expression>
    </formulas>
    <formulas>
        <name>forT_PayerId</name>
        <description>The cited party: the practitioner when Cited Party is Practitioner, otherwise the establishment.</description>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.CitedParty__c}, &quot;Practitioner&quot;), {!$Record.Practitioner__c}, {!$Record.Establishment__c})</expression>
    </formulas>
    <interviewLabel>Record-Trigger: Regulatory Code Violation After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Regulatory Code Violation After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateViolationFee</name>
        <label>Create Violation Fee</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CreateViolationFeeItem</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>forT_PayerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentRecordId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>DUE</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DueDate</field>
            <value>
                <elementReference>forDT_DueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CalculationDate</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Violation fee</stringValue>
            </value>
        </inputAssignments>
        <object>RegulatoryTrxnFee</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>CreateViolationFeeItem</name>
        <label>Create Violation Fee Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SetComplianceDueDate</targetReference>
        </connector>
        <inputAssignments>
            <field>RegulatoryTrxnFeeId</field>
            <value>
                <elementReference>CreateViolationFee</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <stringValue>Violation</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FeeAmount</field>
            <value>
                <elementReference>LookUpViolationFee.Amount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ForYear__c</field>
            <value>
                <elementReference>forT_ForYear</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FeeProduct__c</field>
            <value>
                <elementReference>GetViolationProduct.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CalculationInfo</field>
            <value>
                <stringValue>Violation fee from the Fee Schedule.</stringValue>
            </value>
        </inputAssignments>
        <object>RegulatoryTrxnFeeItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>GetViolationProduct</name>
        <description>The fee code product for the violation fee. Stays empty until the Fee Schedule carries a fee code for Violation.</description>
        <label>Get Violation Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>CreateViolationFee</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FeeCode__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>LookUpViolationFee.FeeCode</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Product2</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>SetComplianceDueDate</name>
        <label>Set Compliance Due Date to Fee Due Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ComplianceDueDate</field>
            <value>
                <elementReference>forDT_DueDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>LookUpViolationFee</targetReference>
        </connector>
        <object>RegulatoryCodeViolation</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
