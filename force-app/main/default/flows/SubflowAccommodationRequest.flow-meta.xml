    <screens>
        <name>AccommodationRequest</name>
        <label>Accommodation Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>GetDraft</targetReference>
        </connector>
        <fields>
            <name>AR_Notice</name>
            <fieldText>&lt;p&gt;If you have a disability and may require some accommodation in taking this examination, request it here. If accommodation is not requested in advance, we cannot guarantee the availability of accommodations on site.&lt;/p&gt;&lt;p&gt;&lt;i&gt;The information requested below and any documentation regarding your disability and your need for accommodations in testing will be considered strictly confidential and will not be shared with any outside source without your expressed written permission.&lt;/i&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>AR_NeedsAccommodation</name>
            <choiceReferences>choice_No</choiceReferences>
            <choiceReferences>choice_Yes</choiceReferences>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>choice_No</elementReference>
            </defaultValue>
            <fieldText>Do you need an accommodation for this examination?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <pauseButtonLabel>Save for later</pauseButtonLabel>
        <pausedText>&lt;p&gt;&lt;b&gt;Your application is saved.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;To pick it up where you left off, go to &lt;a target=&quot;_self&quot; href=&quot;/LPI/s/view-license-permit-status&quot;&gt;My Applications&lt;/a&gt; and choose Continue. Saved applications are kept for 30 days from when you last worked on them, then deleted.&lt;/p&gt;</pausedText>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
