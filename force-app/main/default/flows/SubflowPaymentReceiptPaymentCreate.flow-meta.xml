    </recordCreates>
    <recordLookups>
        <name>GetReceiptApplication</name>
        <description>The individual application the receipt belongs to, if it is one.</description>
        <label>Get Receipt Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetSameSubmission</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_ParentRecordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>CertifiedDateTime__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetSameSubmission</name>
        <description>The other applications certified together with it on one form (for example several licenses renewed at once). One receipt pays them all.</description>
        <label>Get Applications from the Same Submission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughSameSubmission</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetReceiptApplication.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CertifiedDateTime__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetReceiptApplication.CertifiedDateTime__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>CertifiedDateTime__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetExistingPayment</name>
        <label>Get Existing Payment for This Receipt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThereAlreadyAPayment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ChecklistItem__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_ChecklistItemId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Payment__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetOpenFees</name>
        <label>Get Fees Due</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>AreThereFeesDue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentRecordId</field>
            <operator>In</operator>
            <value>
                <elementReference>varT_ParentIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DUE</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RegulatoryTrxnFee</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetFeeItems</name>
        <label>Get Fee Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughFeeItems</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RegulatoryTrxnFeeId</field>
            <operator>In</operator>
            <value>
                <elementReference>varT_FeeIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>FeeAmount</field>
            <operator>NotEqualTo</operator>
            <value>
                <numberValue>0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RegulatoryTrxnFeeItem</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FeeAmount</queriedFields>
        <queriedFields>ForYear__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
