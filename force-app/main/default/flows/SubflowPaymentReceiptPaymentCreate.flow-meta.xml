        <description>The allocations to create, one per fee item.</description>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PaymentAllocation__c</objectType>
    </variables>
</Flow>
