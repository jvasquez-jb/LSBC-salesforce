            <value>
                <elementReference>CreatePayment</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varR_Allocation.FeeItem__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopThroughItemsToAllocate.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varR_Allocation.Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopThroughItemsToAllocate.FeeAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varR_Allocation.ForYear__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopThroughItemsToAllocate.ForYear__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varR_Allocations</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varR_Allocation</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopThroughItemsToAllocate</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>IsThereAlreadyAPayment</name>
        <label>Is There Already a Payment for This Receipt?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>GetReceiptApplication</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>AlreadyPaid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetExistingPayment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>AreThereFeesDue</name>
        <label>Are There Fees Due?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>FeesDue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetOpenFees</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>LoopThroughFees</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAnythingOwed</name>
        <label>Is Anything Owed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Owed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varC_Total</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreatePayment</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Records an online (PayStar) payment once staff accept its receipt. Takes the accepted Payment Receipt checklist item and the record it belongs to (an application or a violation), creates one Card payment for the total of that record&apos;s fees that are still Due (for an individual application, also the fees of the other applications certified with it on the same form, such as several licenses renewed at once), and splits it across their fee items with each item&apos;s license year. The fees then turn Paid through the payment allocation trigger. Does nothing when this receipt already has a payment (the Checklist Item field on Payment is unique) or nothing is due. Called by Record-Trigger: Document Checklist Item After Save. Runs in system context to read fees.</description>
    <environments>Default</environments>
    <interviewLabel>Subflow: Payment Receipt Payment Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subflow: Payment Receipt Payment Create</label>
    <loops>
        <name>LoopThroughSameSubmission</name>
        <label>Loop Through Same Submission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetSameSubmission</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddSubmissionApplication</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>AddReceiptParent</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopThroughFees</name>
        <label>Loop Through Fees</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetOpenFees</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddFeeId</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>GetFeeItems</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopThroughFeeItems</name>
        <label>Loop Through Fee Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetFeeItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddToTotal</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>IsAnythingOwed</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopThroughItemsToAllocate</name>
        <label>Loop Through Fee Items to Allocate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetFeeItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>SetAllocation</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>CreateAllocations</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreatePayment</name>
        <label>Create Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>LoopThroughItemsToAllocate</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>varT_AccountId</elementReference>
            </value>
