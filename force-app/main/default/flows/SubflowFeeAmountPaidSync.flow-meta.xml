<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>AddItemIdToList</name>
        <label>Add Item Id to List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varT_ItemIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LoopThroughFeeItems.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopThroughFeeItems</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>AddAllocationToAmountPaid</name>
        <label>Add Allocation to Amount Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varN_AmountPaid</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LoopThroughAllocations.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopThroughAllocations</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>IsTheFeePayable</name>
        <label>Is The Fee Open For Payment?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, leave it alone</defaultConnectorLabel>
        <rules>
            <name>Payable</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>GetFee.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DUE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetFee.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PARTIALLY_PAID</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetFee.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PAID</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetFeeItems</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>DoesThisAllocationCount</name>
        <label>Does This Allocation Count?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>LoopThroughAllocations</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Counts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LoopThroughAllocations.Id</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>varT_ExcludedAllocationId</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>LoopThroughAllocations.Payment__r.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Returned</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AddAllocationToAmountPaid</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>HasAmountPaidOrStatusChanged</name>
        <label>Has Amount Paid Or Status Changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>forB_AmountPaidChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetFee.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>forT_NewStatus</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetAmountPaidAndStatus</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Totals the payment allocations on one fee's items and sets the fee's Amount Paid and Status: Paid when the total is covered, Partially Paid when some is paid, otherwise Due. Allocations from a Returned payment don't count. Only fees that are Due, Partially Paid or Paid are touched. The fee's own trigger then re-checks stop codes, so a non-payment hold ends when the fee is paid. Runs in system context.</description>
    <environments>Default</environments>
    <formulas>
        <name>forB_AmountPaidChanged</name>
        <description>True when the new total differs from the stored Amount Paid, counting blank as 0.</description>
        <dataType>Boolean</dataType>
        <expression>BLANKVALUE({!GetFee.AmountPaid__c}, 0) &lt;&gt; {!varN_AmountPaid}</expression>
    </formulas>
    <formulas>
        <name>forT_NewStatus</name>
        <description>Paid when the total paid covers the fee, Partially Paid when something is paid, otherwise Due.</description>
        <dataType>String</dataType>
        <expression>IF({!varN_AmountPaid} &gt; 0 &amp;&amp; {!varN_AmountPaid} &gt;= BLANKVALUE({!GetFee.TotalFeeAmount}, 0), &quot;PAID&quot;, IF({!varN_AmountPaid} &gt; 0, &quot;PARTIALLY_PAID&quot;, &quot;DUE&quot;))</expression>
    </formulas>
    <interviewLabel>Subflow: Fee Amount Paid Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subflow: Fee Amount Paid Sync</label>
    <loops>
        <name>LoopThroughFeeItems</name>
        <label>Loop Through Fee Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetFeeItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddItemIdToList</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>GetAllocations</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopThroughAllocations</name>
        <label>Loop Through Allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetAllocations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>DoesThisAllocationCount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>HasAmountPaidOrStatusChanged</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetFee</name>
        <label>Get Regulatory Transaction Fee</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsTheFeePayable</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varT_FeeId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RegulatoryTrxnFee</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetFeeItems</name>
        <label>Get Fee Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughFeeItems</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RegulatoryTrxnFeeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetFee.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RegulatoryTrxnFeeItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetAllocations</name>
        <label>Get Payment Allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughAllocations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FeeItem__c</field>
            <operator>In</operator>
            <value>
                <elementReference>varT_ItemIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PaymentAllocation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>SetAmountPaidAndStatus</name>
        <label>Set Amount Paid and Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetFee.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AmountPaid__c</field>
            <value>
                <elementReference>varN_AmountPaid</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>forT_NewStatus</elementReference>
            </value>
        </inputAssignments>
        <object>RegulatoryTrxnFee</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetFee</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varT_FeeId</name>
        <description>The fee to total.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varT_ExcludedAllocationId</name>
        <description>An allocation to leave out of the total, used when that allocation is being deleted. Optional.</description>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varT_ItemIds</name>
        <description>The Ids of the fee's items.</description>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varN_AmountPaid</name>
        <description>Running total of the allocations that count.</description>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0</numberValue>
        </value>
    </variables>
</Flow>
