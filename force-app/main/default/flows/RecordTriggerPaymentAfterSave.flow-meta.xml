<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>DidTheStatusChange</name>
        <label>Did The Payment Status Change?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>GetHolderFirstRecordInSameSave</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, a new payment</defaultConnectorLabel>
        <rules>
            <name>Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>forB_StatusChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetPaymentAllocations</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsThisTheFirstRecordForTheHolder</name>
        <label>Is This The First Record For The Holder In This Save?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, an earlier record syncs</defaultConnectorLabel>
        <rules>
            <name>First</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetHolderFirstRecordInSameSave.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SyncStopCodes</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>After a payment is recorded or its status changes, for example to Returned, re-checks automatic stop codes for the payer. When the status changes, it first re-totals every fee the payment paid, because a Returned payment no longer counts toward a fee. One stop code sync per payer per save.</description>
    <environments>Default</environments>
    <formulas>
        <name>forB_StatusChanged</name>
        <description>True when an existing payment's status changed, so the fees it paid need re-totalling.</description>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNEW()) &amp;&amp; ISCHANGED({!$Record.Status__c})</expression>
    </formulas>
    <interviewLabel>Record-Trigger: Payment After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Payment After Save</label>
    <loops>
        <name>LoopThroughAllocations</name>
        <label>Loop Through Allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetPaymentAllocations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>SyncFeeAmountPaid</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>GetHolderFirstRecordInSameSave</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetPaymentAllocations</name>
        <label>Get Payment Allocations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughAllocations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Payment__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PaymentAllocation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetHolderFirstRecordInSameSave</name>
        <description>The holder's first record of this object in the same save, by Id. Only that record's run syncs, so a bulk save gives one sync per holder and no duplicate holds.</description>
        <label>Get Holder First Record In Same Save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThisTheFirstRecordForTheHolder</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Payment__c</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>DidTheStatusChange</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.Status__c})</filterFormula>
        <object>Payment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncFeeAmountPaid</name>
        <label>Sync Fee Amount Paid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>LoopThroughAllocations</targetReference>
        </connector>
        <flowName>SubflowFeeAmountPaidSync</flowName>
        <inputAssignments>
            <name>varT_FeeId</name>
            <value>
                <elementReference>LoopThroughAllocations.FeeItem__r.RegulatoryTrxnFeeId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SyncStopCodes</name>
        <label>Sync Stop Codes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
