r><showHeader>false</showHeader></screens><screens><name>AlreadyEnded</name><label>Already Ended</label><locationX>0</locationX><locationY>0</locationY><allowBack>false</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause><fields><name>AE_Message</name><fieldText>&lt;p&gt;This stop code has already ended.&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel><showFooter>true</showFooter><showHeader>false</showHeader></screens><screens><name>CouldNotEndStopCode</name><label>Could Not End Stop Code</label><locationX>0</locationX><locationY>0</locationY><allowBack>false</allowBack><allowFinish>true</allowFinish><allowPause>false</allowPause><fields><name>CNESC_Message</name><fieldText>&lt;p&gt;The stop code could not be ended, and nothing changed.&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields><showFooter>true</showFooter><showHeader>false</showHeader></screens><start><locationX>0</locationX><locationY>0</locationY><connector><targetReference>GetStopCode</targetReference></connector></start><status>Active</status><variables><name>recordId</name><description>The stop code (Record Alert) being ended. Named recordId because the quick action passes the record under that name.</description><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables></Flow>
