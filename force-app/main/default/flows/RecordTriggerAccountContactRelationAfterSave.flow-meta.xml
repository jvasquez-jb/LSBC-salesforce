<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>After a person is linked to an establishment, or their roles or active status change, re-checks automatic stop codes for both: the salon needs a licensed owner or manager, and a booth renter needs a current license.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Account Contact Relation After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Account Contact Relation After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SyncSalon</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.Roles}) || ISCHANGED({!$Record.IsActive}) || ISCHANGED({!$Record.EndDate})</filterFormula>
        <object>AccountContactRelation</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncSalon</name>
        <label>Sync Stop Codes for Salon</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SyncPerson</targetReference>
        </connector>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SyncPerson</name>
        <label>Sync Stop Codes for Person</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.Contact.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
