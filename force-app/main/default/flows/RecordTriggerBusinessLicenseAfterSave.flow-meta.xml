<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>AddRelatedSalonToList</name>
        <label>Add Related Salon to List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varT_RelatedSalonIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LoopThroughHolderRelations.AccountId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopThroughHolderRelations</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>IsThisTheFirstRecordForTheHolder</name>
        <label>Is This The First Record For The Holder In This Save?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, an earlier record syncs</defaultConnectorLabel>
        <rules>
            <name>First</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetHolderFirstRecordInSameSave.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetHolderStopCodeSyncPendingToTrue</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>After a license is created, or its holder, type, status or expiration date changes, queues a re-check of automatic stop codes for the holder and for any salon where the holder is linked as owner or manager. One sync per holder per save. The re-check runs in the background a few seconds after the save (Record-Trigger: Account After Save).</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Business License After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Business License After Save</label>
    <loops>
        <name>LoopThroughHolderRelations</name>
        <label>Loop Through Holder Relations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetHolderRelations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AddRelatedSalonToList</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>SetRelatedSalonsStopCodeSyncPendingToTrue</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHolderFirstRecordInSameSave</name>
        <description>The holder's first record of this object in the same save, by Id. Only that record's run ticks Stop Code Sync Pending on the holder, so a bulk save queues one background sync per holder.</description>
        <label>Get Holder First Record In Same Save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsThisTheFirstRecordForTheHolder</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LastModifiedDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>BusinessLicense</object>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetHolderRelations</name>
        <label>Get Holder Relations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughHolderRelations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account.PersonContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AccountContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>SetRelatedSalonsStopCodeSyncPendingToTrue</name>
        <description>Queues the background stop code sync for every account the license holder is related to (a manager or owner license affects the salon&apos;s holds).</description>
        <label>Set Related Salons Stop Code Sync Pending to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>varT_RelatedSalonIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>StopCodeSyncPending__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>StopCodeSyncPending__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>SetHolderStopCodeSyncPendingToTrue</name>
        <description>Queues the background stop code sync for the holder (Record-Trigger: Account After Save) instead of syncing during this save.</description>
        <label>Set Holder Stop Code Sync Pending to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetHolderRelations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>StopCodeSyncPending__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>StopCodeSyncPending__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetHolderFirstRecordInSameSave</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.PeriodEnd}) || ISCHANGED({!$Record.Status}) || ISCHANGED({!$Record.RegulatoryAuthorizationTypeId}) || ISCHANGED({!$Record.AccountId})</filterFormula>
        <object>BusinessLicense</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varT_RelatedSalonIds</name>
        <description>The accounts the license holder is related to, whose stop codes are re-checked.</description>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
