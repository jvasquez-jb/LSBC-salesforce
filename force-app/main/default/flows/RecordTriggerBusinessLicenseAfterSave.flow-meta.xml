<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>After a license is created, or its holder, type, status or expiration date changes, re-checks automatic stop codes for the holder and for any salon where the holder is linked as owner or manager.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Business License After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Business License After Save</label>
    <loops>
        <name>LoopThroughHolderRelations</name>
        <label>Loop Through Holder Relations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>GetHolderRelations</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>SyncRelatedSalon</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHolderRelations</name>
        <label>Get Holder Relations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopThroughHolderRelations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account.PersonContactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AccountContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SyncLicenseHolder</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.PeriodEnd}) || ISCHANGED({!$Record.Status}) || ISCHANGED({!$Record.RegulatoryAuthorizationTypeId}) || ISCHANGED({!$Record.AccountId})</filterFormula>
        <object>BusinessLicense</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncLicenseHolder</name>
        <label>Sync Stop Codes for License Holder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetHolderRelations</targetReference>
        </connector>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SyncRelatedSalon</name>
        <label>Sync Stop Codes for Related Salon</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>LoopThroughHolderRelations</targetReference>
        </connector>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>LoopThroughHolderRelations.AccountId</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
