    <screens>
        <name>AddStopCode</name>
        <label>Add Stop Code</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>GetExistingHold</targetReference>
        </connector>
        <fields>
            <name>ASC_Category</name>
            <choiceReferences>recChoice_StaffStopCodes</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Stop code</fieldText>
            <fieldType>DropdownBox</fieldType>
            <helpText>Only codes staff set are listed. Automatic codes are opened and ended by the system.</helpText>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>ASC_Reason</name>
            <dataType>String</dataType>
            <fieldText>Reason</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>Why the hold is being set. Up to 255 characters.</helpText>
            <isRequired>true</isRequired>
            <validationRule>
                <errorMessage>Keep the reason to 255 characters or fewer.</errorMessage>
                <formulaExpression>LEN({!ASC_Reason}) &lt;= 255</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>ASC_EffectiveDate</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>$Flow.CurrentDate</elementReference>
            </defaultValue>
            <fieldText>Effective date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
