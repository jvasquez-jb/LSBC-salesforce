    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>IsThisCodeAlreadyOpen</name>
        <label>Is This Code Already Open?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>CreateStopCode</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>CodeIsOpen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetExistingHold.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AlreadyOpen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
