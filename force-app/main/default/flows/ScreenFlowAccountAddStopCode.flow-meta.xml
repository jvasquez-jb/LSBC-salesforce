    <formulas>
        <name>forDT_EffectiveDate</name>
        <description>Now when the hold starts today, otherwise midday on the chosen date so the date shows correctly in Louisiana.</description>
        <dataType>DateTime</dataType>
        <expression>IF({!ASC_EffectiveDate} = TODAY(), NOW(), DATETIMEVALUE({!ASC_EffectiveDate}) + 0.5)</expression>
    </formulas>
    <formulas>
        <name>forDT_OpenHoldEnd</name>
        <description>An open hold carries 31 December 4000, because the end date is required.</description>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(&quot;4000-12-31 00:00:00&quot;)</expression>
    </formulas>
