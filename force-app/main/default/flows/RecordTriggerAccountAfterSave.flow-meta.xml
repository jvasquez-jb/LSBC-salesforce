<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>IsAStopCodeSyncPending</name>
        <label>Is a Stop Code Sync Pending?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>IsAPortalAccessSyncPending</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>StopCodeSyncPending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StopCodeSyncPending__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetStopCodeSyncPendingToFalse</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAPortalAccessSyncPending</name>
        <label>Is a Portal Access Sync Pending?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>PortalAccessSyncPending</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PortalAccessSyncPending__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetPortalAccessSyncPendingToFalse</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Runs two background jobs for an account once the save is committed. Stop codes: the license, relationship, bond, exam, application, fee, payment and hours triggers tick Stop Code Sync Pending on the holder instead of syncing during the save, and this flow re-checks the holder&apos;s automatic stop codes once per holder however many records the save touches. Portal access: the relationship, portal user, license, business application, violation and fee triggers tick Portal Access Sync Pending on a business, and this flow brings its owners&apos;, managers&apos; and school administrators&apos; portal access up to date (Subflow: Portal Business Access Sync). Each flag is unticked first, so a later save queues another run.</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: Account After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record-Trigger: Account After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    
    <recordUpdates>
        <name>SetPortalAccessSyncPendingToFalse</name>
        <label>Set Portal Access Sync Pending to False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SyncPortalAccess</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>PortalAccessSyncPending__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>SetStopCodeSyncPendingToFalse</name>
        <label>Set Stop Code Sync Pending to False</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SyncStopCodes</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>StopCodeSyncPending__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>(1 AND 2) OR (3 AND 4)</filterLogic>
        <filters>
            <field>StopCodeSyncPending__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>StopCodeSyncPending__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PortalAccessSyncPending__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PortalAccessSyncPending__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>IsAStopCodeSyncPending</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>SyncStopCodes</name>
        <label>Sync Stop Codes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsAPortalAccessSyncPending</targetReference>
        </connector>
        <flowName>SubflowStopCodeSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>SyncPortalAccess</name>
        <label>Sync Portal Access</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>SubflowPortalBusinessAccessSync</flowName>
        <inputAssignments>
            <name>varT_AccountId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
