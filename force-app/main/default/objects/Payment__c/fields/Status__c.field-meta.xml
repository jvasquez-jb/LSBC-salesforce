<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Where the payment stands. Returned means the payment bounced, for example a check returned for insufficient funds.</description>
    <inlineHelpText>Completed when received; Refunded once a refund is sent; Returned if the payment bounced.</inlineHelpText>
    <label>Status</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Completed</fullName>
                <default>true</default>
                <label>Completed</label>
            </value>
            <value>
                <fullName>Refunded</fullName>
                <default>false</default>
                <label>Refunded</label>
            </value>
            <value>
                <fullName>Returned</fullName>
                <default>false</default>
                <label>Returned</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
