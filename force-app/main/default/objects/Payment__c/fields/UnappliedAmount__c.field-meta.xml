<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UnappliedAmount__c</fullName>
    <description>Money from this payment not yet applied to any fee.</description>
    <formula><![CDATA[Amount__c - AppliedAmount__c]]></formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Amount minus Applied Amount.</inlineHelpText>
    <label>Unapplied Amount</label>
    <precision>18</precision>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
