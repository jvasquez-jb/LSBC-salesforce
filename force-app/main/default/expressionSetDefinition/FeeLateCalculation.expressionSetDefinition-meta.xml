<?xml version="1.0" encoding="UTF-8"?>
<ExpressionSetDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Works out what a late renewal costs: license years missed, capped late fees, the renewal amount, and whether a restoration exam is needed. Amounts come from the Fee Schedule.</description>
    <executionScale>Low</executionScale>
    <label>Fee Late Calculation</label>
    <processType>Bre</processType>
    <template>false</template>
    <versions>
        <fullName>FeeLateCalculation_V1</fullName>
        <description>Works out what a late renewal costs: license years missed, capped late fees, the renewal amount, and whether a restoration exam is needed. Amounts come from the Fee Schedule.</description>
        <expressionSetDefinition>FeeLateCalculation</expressionSetDefinition>
        <label>Fee Late Calculation V1</label>
        <rank>1</rank>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <startDate>2026-01-01T00:00:00.000Z</startDate>
        <status>Active</status>
        <versionNumber>1</versionNumber>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>YearsBetween</assignedParameter>
                <expression>YEAR(AsOfDate) - YEAR(PaidThroughDate)</expression>
            </assignment>
            <description>Calendar years between the paid-through date and the as-of date.</description>
            <label>Set Years Between</label>
            <name>SetYearsBetween</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>1</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>DelinquentYears</assignedParameter>
                <expression>IF(PaidThroughDate &gt;= AsOfDate, 0, YearsBetween + IF(ADDMONTHS(PaidThroughDate, 12 * YearsBetween) &lt; AsOfDate, 1, 0))</expression>
            </assignment>
            <description>License years missed: each anniversary of the paid-through date that has passed counts as one.</description>
            <label>Set Delinquent Years</label>
            <name>SetDelinquentYears</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>2</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>RequiresRestorationExam</assignedParameter>
                <expression>PaidThroughDate &lt; ADDMONTHS(AsOfDate, 0 - RestorationLapseMonths)</expression>
            </assignment>
            <description>True when the license has been expired longer than the restoration limit.</description>
            <label>Set Requires Restoration Exam</label>
            <name>SetRequiresRestorationExam</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>3</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>LateFeeTotal</assignedParameter>
                <expression>IF(IsSchool, IF(DelinquentYears &gt; 0, FailureToRenewFee, 0), MIN(DelinquentYears * LateFeePerYear, LateFeeCap))</expression>
            </assignment>
            <description>Total late fees: yearly penalties up to the cap for individuals, the failure-to-renew fee for a late school.</description>
            <label>Set Late Fee Total</label>
            <name>SetLateFeeTotal</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>4</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>RenewalAmount</assignedParameter>
                <expression>IF(IsSchool &amp;&amp; DelinquentYears &gt; 0, RenewalFee * 2, RenewalFee)</expression>
            </assignment>
            <description>Renewal fee to charge, doubled for a late school.</description>
            <label>Set Renewal Amount</label>
            <name>SetRenewalAmount</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>5</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <variables>
            <collection>false</collection>
            <dataType>Date</dataType>
            <description>The date the renewal is being paid, normally today.</description>
            <input>true</input>
            <name>AsOfDate</name>
            <output>false</output>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Date</dataType>
            <description>The date the license is paid through, its current expiration date.</description>
            <input>true</input>
            <name>PaidThroughDate</name>
            <output>false</output>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Boolean</dataType>
            <description>True for a school renewal, which is charged double plus a failure-to-renew fee instead of yearly late fees.</description>
            <input>true</input>
            <name>IsSchool</name>
            <output>false</output>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Currency</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Late penalty per missed year, from the Fee Schedule.</description>
            <input>true</input>
            <name>LateFeePerYear</name>
            <output>false</output>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Currency</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Renewal fee for the license type, from the Fee Schedule.</description>
            <input>true</input>
            <name>RenewalFee</name>
            <output>false</output>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Currency</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Failure to timely renew fee for schools, from the Fee Schedule.</description>
            <input>true</input>
            <name>FailureToRenewFee</name>
            <output>false</output>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Currency</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Most that late fees can total for one renewal.</description>
            <input>false</input>
            <name>LateFeeCap</name>
            <output>false</output>
            <type>Constant</type>
            <value>465</value>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Numeric</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Months a license can be expired before a restoration examination is required.</description>
            <input>false</input>
            <name>RestorationLapseMonths</name>
            <output>false</output>
            <type>Constant</type>
            <value>36</value>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Numeric</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Calendar years between the paid-through date and the as-of date.</description>
            <input>false</input>
            <name>YearsBetween</name>
            <output>false</output>
            <resultStep>SetYearsBetween</resultStep>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Numeric</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>License years missed: each anniversary of the paid-through date that has passed counts as one.</description>
            <input>false</input>
            <name>DelinquentYears</name>
            <output>true</output>
            <resultStep>SetDelinquentYears</resultStep>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Boolean</dataType>
            <description>True when the license has been expired longer than the restoration limit.</description>
            <input>false</input>
            <name>RequiresRestorationExam</name>
            <output>true</output>
            <resultStep>SetRequiresRestorationExam</resultStep>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Currency</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Total late fees: yearly penalties up to the cap for individuals, the failure-to-renew fee for a late school.</description>
            <input>false</input>
            <name>LateFeeTotal</name>
            <output>true</output>
            <resultStep>SetLateFeeTotal</resultStep>
            <type>Variable</type>
        </variables>
        <variables>
            <collection>false</collection>
            <dataType>Currency</dataType>
            <decimalPlaces>2</decimalPlaces>
            <description>Renewal fee to charge, doubled for a late school.</description>
            <input>false</input>
            <name>RenewalAmount</name>
            <output>true</output>
            <resultStep>SetRenewalAmount</resultStep>
            <type>Variable</type>
        </variables>
    </versions>
</ExpressionSetDefinition>
