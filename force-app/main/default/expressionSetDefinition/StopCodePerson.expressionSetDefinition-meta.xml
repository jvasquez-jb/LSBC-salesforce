<?xml version="1.0" encoding="UTF-8"?>
<ExpressionSetDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Decides which automatic stop codes apply to a person: licensee, student, instructor or booth renter. Each output is true when that hold should be open. The calling flow supplies the facts and opens or ends the holds.</description>
    <executionScale>Low</executionScale>
    <label>Stop Code Person</label>
    <processType>Bre</processType>
    <template>false</template>
    <versions>
        <fullName>StopCodePerson_V1</fullName>
        <description>Which automatic stop codes apply to a person. Each output is true when that hold should be open; the calling flow opens or ends them. Instructors need a current license in their own discipline; booth renters any current operator license.</description>
        <expressionSetDefinition>StopCodePerson</expressionSetDefinition>
        <label>Stop Code Person V1</label>
        <rank>1</rank>
        <shouldShowExplExternally>false</shouldShowExplExternally>
        <startDate>2026-01-01T00:00:00.000Z</startDate>
        <status>Active</status>
        <versionNumber>1</versionNumber>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode01</assignedParameter>
                <expression>HasReturnedPayment</expression>
            </assignment>
            <description>Returned payment.</description>
            <label>Set Stop Code 01</label>
            <name>SetStopCode01</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>1</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode04</assignedParameter>
                <expression>HasOpenLicensureApplication &amp;&amp; NOT(ISBLANK(CompletionThresholdHours)) &amp;&amp; ApprovedHours &lt; CompletionThresholdHours</expression>
            </assignment>
            <description>Applying for licensure with hours below the completion threshold.</description>
            <label>Set Stop Code 04</label>
            <name>SetStopCode04</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>2</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode05</assignedParameter>
                <expression>HoldsCosmetologistLicense &amp;&amp; NOT(ISBLANK(CosmetologistPeriodEnd)) &amp;&amp; CosmetologistPeriodEnd &lt; AsOfDate</expression>
            </assignment>
            <description>Cosmetologist license expired.</description>
            <label>Set Stop Code 05</label>
            <name>SetStopCode05</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>3</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode06</assignedParameter>
                <expression>IsBoothRenter &amp;&amp; NOT(HoldsCurrentOperatorLicense)</expression>
            </assignment>
            <description>Booth renter without a current operator license (cosmetologist, esthetician or manicurist).</description>
            <label>Set Stop Code 06</label>
            <name>SetStopCode06</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>4</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode07</assignedParameter>
                <expression>IsCosmetologyInstructor &amp;&amp; NOT(HoldsCosmetologistLicense &amp;&amp; NOT(ISBLANK(CosmetologistPeriodEnd)) &amp;&amp; CosmetologistPeriodEnd &gt;= AsOfDate)</expression>
            </assignment>
            <description>Cosmetology instructor without a current cosmetologist license.</description>
            <label>Set Stop Code 07</label>
            <name>SetStopCode07</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>5</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode08</assignedParameter>
                <expression>(RequiresNationalExam &amp;&amp; LatestNationalResult == "Fail") || (RequiresPracticalExam &amp;&amp; LatestPracticalResult == "Fail") || (RequiresStateExam &amp;&amp; LatestStateResult == "Fail")</expression>
            </assignment>
            <description>Latest attempt at a required examination failed.</description>
            <label>Set Stop Code 08</label>
            <name>SetStopCode08</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>6</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode09</assignedParameter>
                <expression>IsEstheticianInstructor &amp;&amp; NOT(HoldsEstheticianLicense &amp;&amp; NOT(ISBLANK(EstheticianPeriodEnd)) &amp;&amp; EstheticianPeriodEnd &gt;= AsOfDate)</expression>
            </assignment>
            <description>Esthetician instructor without a current esthetician license.</description>
            <label>Set Stop Code 09</label>
            <name>SetStopCode09</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>7</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode15</assignedParameter>
                <expression>NOT(ISBLANK(EarliestLapsedPeriodEnd)) &amp;&amp; EarliestLapsedPeriodEnd &lt; ADDMONTHS(AsOfDate, 0 - RestorationLapseMonths)</expression>
            </assignment>
            <description>A license expired longer ago than the restoration limit.</description>
            <label>Set Stop Code 15</label>
            <name>SetStopCode15</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>8</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode17</assignedParameter>
                <expression>HasOpenLicensureApplication &amp;&amp; ((RequiresNationalExam &amp;&amp; LatestNationalResult != "Pass" &amp;&amp; LatestNationalResult != "Fail") || (RequiresPracticalExam &amp;&amp; LatestPracticalResult != "Pass" &amp;&amp; LatestPracticalResult != "Fail") || (RequiresStateExam &amp;&amp; LatestStateResult != "Pass" &amp;&amp; LatestStateResult != "Fail"))</expression>
            </assignment>
            <description>A required examination has not been taken.</description>
            <label>Set Stop Code 17</label>
            <name>SetStopCode17</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>9</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode20</assignedParameter>
                <expression>NOT(ISBLANK(LatestHoursEndDate)) &amp;&amp; NOT(ISBLANK(CompletionThresholdHours)) &amp;&amp; ApprovedHours &lt; CompletionThresholdHours &amp;&amp; LatestHoursEndDate &lt; AsOfDate + (0 - ReRegistrationDays)</expression>
            </assignment>
            <description>A student with no hours submitted for the re-registration period.</description>
            <label>Set Stop Code 20</label>
            <name>SetStopCode20</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>10</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode21</assignedParameter>
                <expression>NOT(ISBLANK(OldestOverdueFeeDueDate)) &amp;&amp; OldestOverdueFeeDueDate &lt; AsOfDate</expression>
            </assignment>
            <description>A fee is unpaid past its due date.</description>
            <label>Set Stop Code 21</label>
            <name>SetStopCode21</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>11</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
        <steps>
            <actionType>AssignParameterValues</actionType>
            <assignment>
                <assignedParameter>StopCode31</assignedParameter>
                <expression>LatestRestorationResult == "Fail"</expression>
            </assignment>
            <description>Latest restoration examination attempt failed.</description>
            <label>Set Stop Code 31</label>
            <name>SetStopCode31</name>
            <resultIncluded>true</resultIncluded>
            <sequenceNumber>12</sequenceNumber>
            <shouldExposExecPathMsgOnly>true</shouldExposExecPathMsgOnly>
            <shouldExposeConditionDetails>false</shouldExposeConditionDetails>
            <shouldShowExplExternally>false</shouldShowExplExternally>
            <stepType>BusinessKnowledgeModel</stepType>
        </steps>
