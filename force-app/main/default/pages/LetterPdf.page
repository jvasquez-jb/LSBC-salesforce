<apex:page controller="LetterPdfController" renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" showHeader="false" sidebar="false" standardStylesheets="false">
<html>
<head>
    <style type="text/css">
        @page { size: letter; margin: 0.9in 1in 1in 1in; }
        body { font-family: "Times New Roman", serif; font-size: 11.5pt; color: #111111; line-height: 1.4; }
        .letterhead { border-bottom: 2px solid #051E5F; padding-bottom: 8px; margin-bottom: 28px; }
        .letterhead td { vertical-align: middle; }
        .board { font-size: 15pt; font-weight: bold; color: #051E5F; }
        .boardline { font-size: 9.5pt; color: #333333; }
        .date { margin-bottom: 18px; }
        .address { margin-bottom: 20px; }
        .heading { font-weight: bold; margin-bottom: 16px; }
        p { margin: 0 0 11px 0; }
        ul { margin: 0 0 11px 22px; padding: 0; }
    </style>
</head>
<body>
    <table class="letterhead" width="100%" cellpadding="0" cellspacing="0">
        <tr>
            <td width="80"><img src="{!$Resource.PortalSeal}" width="68" height="68"/></td>
            <td>
                <div class="board">Louisiana State Board of Cosmetology</div>
                <div class="boardline">[Board mailing address]</div>
                <div class="boardline">[Board phone] &#183; [Board website]</div>
            </td>
        </tr>
    </table>
    <div class="date"><apex:outputText value="{!letterDate}"/></div>
    <div class="address">
        <div><apex:outputText value="{!addresseeName}"/></div>
        <apex:repeat value="{!addressLines}" var="line"><div><apex:outputText value="{!line}"/></div></apex:repeat>
    </div>
    <div class="heading">RE:&#160;<apex:outputText value="{!heading}"/></div>
    <apex:outputText value="{!bodyHtml}" escape="false"/>
</body>
</html>
</apex:page>
