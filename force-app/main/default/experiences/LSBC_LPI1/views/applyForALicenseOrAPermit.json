          "componentAttributes": {
            "richTextValue": "<!-- Page heading and one-line introduction -->\n<h1 class=\"lsbc-page-title\">Apply for a License or Permit</h1>\n<p class=\"lsbc-page-intro\">Apply online, pay with PayStar and upload your documents.</p>"
          },
