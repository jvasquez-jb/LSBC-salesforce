      "components": [
        {
          "componentAttributes": {
            "richTextValue": "<!-- Apply: the applications that can be completed online. Each opens its own page with the form.\n     Add a row here when a new online form goes live. -->\n<section class=\"lsbc-section\">\n  <p>Choose the application you need. You can save an application and finish it later from My Applications; saved applications are kept for 30 days.</p>\n\n  <div class=\"lsbc-doclist\">\n\n    <!-- Reciprocity: Regular (Cosmetology, Esthetician, Manicurist, Instructor), Military and Foreign -->\n    <div class=\"lsbc-doclist__item\">\n      <a href=\"/LPI/s/apply-reciprocity\">Apply for Reciprocity</a>\n      <span>Transfer a cosmetology, esthetician, manicurist or instructor license from another state or country, including military reciprocity.</span>\n    </div>\n\n  </div>\n\n  <p>Other applications are on the <a href=\"/LPI/s/forms-and-resources\">Forms &amp; Resources</a> page until they are available online.</p>\n</section>"
          },
