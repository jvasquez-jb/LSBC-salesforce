            "richTextValue": "<!-- Page heading and one-line introduction -->\n<h1 class=\"lsbc-page-title\">Forms and Resources</h1>\n<p class=\"lsbc-page-intro\">Applications, reference documents and the laws and rules.</p>"
          },
          "componentName": "forceCommunity:richTextInline",
