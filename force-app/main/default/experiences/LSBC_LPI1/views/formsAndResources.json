          "componentAttributes": {
            "richTextValue": "<h1 class=\"lsbc-page-title\">Forms and Resources</h1><p class=\"lsbc-page-intro\">Applications, reference documents and the laws and rules.</p>"
          },
          "componentName": "forceCommunity:richTextInline",
          "id": "7571b21e-42b2-4f1b-8dfb-dfc93c4adbe0",
          "renderPriority": "NEUTRAL",
          "renditionMap": {},
