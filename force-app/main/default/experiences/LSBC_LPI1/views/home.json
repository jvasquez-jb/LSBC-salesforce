      "components": [
        {
          "componentAttributes": {
            "richTextValue": "<!-- Popular tasks: two columns of links, each row with a chevron (styled in the theme CSS) -->\n<section class=\"lsbc-section\" aria-labelledby=\"lsbc-popular-title\">\n  <h2 class=\"lsbc-section__title\" id=\"lsbc-popular-title\">Popular tasks</h2>\n  <div class=\"lsbc-popular\">\n\n    <!-- Left column -->\n    <div class=\"lsbc-popular__col\">\n      <a href=\"/LPI/s/renew-license-permit\">Renew my license</a>\n      <a href=\"/LPI/s/search-license-permit-holder\">Look up a license</a>\n      <a href=\"/LPI/s/apply-license-permit\">Apply for reciprocity</a>\n    </div>\n\n    <!-- Right column -->\n    <div class=\"lsbc-popular__col\">\n      <a href=\"/LPI/s/renew-license-permit\">Request a duplicate license</a>\n      <a href=\"/LPI/s/view-fees\">Pay a fee</a>\n      <a href=\"/LPI/s/file-a-complaint\">File a complaint</a>\n    </div>\n\n  </div>\n</section>"
          },
          "componentName": "forceCommunity:htmlBlock",
          "id": "83076612-e9a9-442a-bcb4-a66b2fa20e20",
          "renditionMap": {},
          "renderPriority": "NEUTRAL",
          "type": "component"
        },
        {
          "componentAttributes": {
            "richTextValue": "<!-- All topics: 3 x 2 grid of tiles, each an icon and a label (icons are decorative, so alt is empty) -->\n<section class=\"lsbc-section\" aria-labelledby=\"lsbc-topics-title\">\n  <h2 class=\"lsbc-section__title\" id=\"lsbc-topics-title\">All topics</h2>\n  <div class=\"lsbc-topics\">\n    <!-- Renew a license or request a duplicate -->\n    <a class=\"lsbc-tile\" href=\"/LPI/s/renew-license-permit\">\n      <img src=\"/sfsites/c/resource/PortalIconLicense\" alt=\"\">\n      <span>Licenses &amp; Renewals</span>\n    </a>\n    <!-- Start an application -->\n    <a class=\"lsbc-tile\" href=\"/LPI/s/apply-license-permit\">\n      <img src=\"/sfsites/c/resource/PortalIconApply\" alt=\"\">\n      <span>Apply for a License</span>\n    </a>\n    <!-- Public license search -->\n    <a class=\"lsbc-tile\" href=\"/LPI/s/search-license-permit-holder\">\n      <img src=\"/sfsites/c/resource/PortalIconLookup\" alt=\"\">\n      <span>Look Up a License</span>\n    </a>\n    <!-- School directory -->\n    <a class=\"lsbc-tile\" href=\"/LPI/s/find-a-school\">\n      <img src=\"/sfsites/c/resource/PortalIconSchool\" alt=\"\">\n      <span>Find a School</span>\n    </a>\n    <!-- Paper forms and reference documents -->\n    <a class=\"lsbc-tile\" href=\"/LPI/s/forms-and-resources\">\n      <img src=\"/sfsites/c/resource/PortalIconForms\" alt=\"\">\n      <span>Forms &amp; Resources</span>\n    </a>\n    <!-- Public complaint form -->\n    <a class=\"lsbc-tile\" href=\"/LPI/s/file-a-complaint\">\n      <img src=\"/sfsites/c/resource/PortalIconComplaint\" alt=\"\">\n      <span>File a Complaint</span>\n    </a>\n\n  </div>\n</section>"
          },
          "componentName": "forceCommunity:htmlBlock",
          "id": "1aaa3c58-0373-4185-9025-eaa24288eff4",
