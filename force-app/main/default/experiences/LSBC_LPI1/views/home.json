        {
          "componentAttributes": {
            "richTextValue": "<!-- Need more help: grey band with two cards (contact the Board, file a complaint) -->\n<section class=\"lsbc-help\" aria-labelledby=\"lsbc-help-title\">\n  <h2 id=\"lsbc-help-title\">Need more help?</h2>\n  <!-- Office hours: placeholder until the Board confirms them -->\n  <p>Our office is open Monday to Friday.</p>\n\n  <div class=\"lsbc-help__cards\">\n\n    <!-- Card 1: phone and postal address -->\n    <div class=\"lsbc-help__card\">\n      <img src=\"/sfsites/c/resource/PortalIconContact\" alt=\"\">\n      <div>\n        <a href=\"tel:+12257563404\">Contact the Board</a>\n        <p>Call 225-756-3404, or write to 11622 Sunbelt Court, Baton Rouge, Louisiana 70809.</p>\n      </div>\n    </div>\n\n    <!-- Card 2: public complaint form -->\n    <div class=\"lsbc-help__card\">\n      <img src=\"/sfsites/c/resource/PortalIconComplaint\" alt=\"\">\n      <div>\n        <a href=\"/LPI/s/file-a-complaint\">File a Complaint</a>\n        <p>Report a salon, school or practitioner. You can stay anonymous.</p>\n      </div>\n    </div>\n\n  </div>\n</section>"
          },
