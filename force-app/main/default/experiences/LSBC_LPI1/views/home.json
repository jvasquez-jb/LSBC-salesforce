        {
          "componentAttributes" : {
            "richTextValue" : "<div class=\"lsbc-wrap\">\n\n  <!-- Popular tasks: kicker, serif headline, one line each -->\n  <section aria-labelledby=\"lsbc-popular-title\">\n    <h2 class=\"lsbc-rubric\" id=\"lsbc-popular-title\">Popular tasks</h2>\n    <div class=\"lsbc-stories\">\n      <article class=\"lsbc-story\"><span class=\"lsbc-kicker\">Licenses</span><h3><a href=\"/LPI/s/renew-license-permit\">Renew my license</a></h3><p>Renew before it expires and avoid the late fee.</p></article>\n      <article class=\"lsbc-story\"><span class=\"lsbc-kicker\">Public search</span><h3><a href=\"/LPI/s/search-license-permit-holder\">Look up a license</a></h3><p>Check a practitioner, salon or school before you book.</p></article>\n      <article class=\"lsbc-story\"><span class=\"lsbc-kicker\">New to Louisiana</span><h3><a href=\"/LPI/s/apply-license-permit\">Apply for reciprocity</a></h3><p>Licensed in another state? Transfer your license here.</p></article>\n      <article class=\"lsbc-story\"><span class=\"lsbc-kicker\">Licenses</span><h3><a href=\"/LPI/s/renew-license-permit\">Request a duplicate license</a></h3><p>Replace a lost or damaged license.</p></article>\n      <article class=\"lsbc-story\"><span class=\"lsbc-kicker\">Payments</span><h3><a href=\"/LPI/s/view-fees\">Pay a fee</a></h3><p>See what you owe and pay online.</p></article>\n      <article class=\"lsbc-story\"><span class=\"lsbc-kicker\">Public safety</span><h3><a href=\"/LPI/s/file-a-complaint\">File a complaint</a></h3><p>Report a salon, school or practitioner. You can stay anonymous.</p></article>\n    </div>\n  </section>\n\n  <!-- Need more help -->\n  <section aria-labelledby=\"lsbc-help-title\">\n    <h2 class=\"lsbc-rubric\" id=\"lsbc-help-title\">Need more help?</h2>\n    <div class=\"lsbc-help\">\n      <div class=\"lsbc-help__item\">\n        <span class=\"lsbc-kicker\">Contact the Board</span>\n        <h3><a href=\"tel:+12257563404\">225-756-3404</a></h3>\n        <!-- Office hours: placeholder until the Board confirms them -->\n        <p>Monday to Friday. 11622 Sunbelt Court, Baton Rouge, Louisiana 70809.</p>\n      </div>\n      <div class=\"lsbc-help__item\">\n        <span class=\"lsbc-kicker\">Report a concern</span>\n        <h3><a href=\"/LPI/s/file-a-complaint\">File a complaint</a></h3>\n        <p>Report a salon, school or practitioner. You can stay anonymous.</p>\n      </div>\n    </div>\n  </section>\n\n</div>"
