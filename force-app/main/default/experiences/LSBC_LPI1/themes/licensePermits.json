{
  "activeBrandingSetId": "6a521171-2dde-4587-b4cc-fc1d52db5d6d",
  "customCSS": "/* LSBC portal: help-centre layout in LSBC colours. Navy #051E5F, seal blue #1F4E9C, gold #C9A43A. */\n:root { --lsbc-navy: #051E5F; --lsbc-blue: #1F4E9C; --lsbc-gold: #C9A43A; --lsbc-page: #F5F6F7; --lsbc-band: #E9EBEF; --lsbc-border: #D8DCE3; --lsbc-text: #1B1B1F; }\nbody, .siteforceStarterBody { background: var(--lsbc-page); color: var(--lsbc-text); }\nh1, h2, h3, .lsbc-section__title { font-family: \"Montserrat\", \"Lato\", sans-serif; }\n\n/* Hero */\n.forceCommunityThemeHeroStarter h1, .forceCommunityThemeHeroStarter .title { font-size: 3.25rem; font-weight: 700; line-height: 1.1; letter-spacing: -0.5px; }\n.forceCommunityThemeHeroStarter .subtitle { order: -1; font-size: 1.35rem; font-weight: 500; margin-bottom: 0.25rem; }\n.forceCommunityThemeSearchHero input { height: 3.5rem; font-size: 1.125rem; border-width: 2px; }\n.forceCommunityThemeSearchHero input:focus { outline: 3px solid var(--lsbc-gold); outline-offset: 2px; }\n\n/* Shared section layout */\n.lsbc-section { max-width: 1000px; margin: 0 auto; padding: 3rem 1rem 1rem; }\n.lsbc-section__title { font-size: 2rem; font-weight: 700; margin: 0 0 2rem; color: var(--lsbc-text); }\n\n/* Popular tasks: two bordered columns of rows with chevrons */\n.lsbc-popular { display: grid; grid-template-columns: 1fr 1fr; gap: 0 3rem; }\n.lsbc-popular__col { list-style: none; margin: 0; padding: 0; background: #fff; border: 1px solid var(--lsbc-border); border-radius: 4px; }\n.lsbc-popular__col a + a { border-top: 1px solid var(--lsbc-border); }\n.lsbc-popular a { display: flex; justify-content: space-between; align-items: center; padding: 1.4rem 1.6rem; font-size: 1.25rem; font-weight: 600; color: var(--lsbc-blue); text-decoration: none; }\n.lsbc-popular a::after { content: \"\"; width: 0.6rem; height: 0.6rem; border-right: 2.5px solid var(--lsbc-text); border-top: 2.5px solid var(--lsbc-text); transform: rotate(45deg); margin-left: 1rem; flex: none; }\n.lsbc-popular a:hover, .lsbc-popular a:focus { background: #F7F9FC; text-decoration: underline; }\n\n/* All topics: 3 x 2 tiles */\n.lsbc-topics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }\n.lsbc-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; min-height: 13rem; padding: 1.5rem; background: #fff; border: 1px solid var(--lsbc-border); border-radius: 6px; text-decoration: none; color: var(--lsbc-text); font-size: 1.35rem; font-weight: 700; text-align: center; }\n.lsbc-tile img { width: 5rem; height: 5rem; }\n.lsbc-tile:hover, .lsbc-tile:focus { border-color: var(--lsbc-navy); box-shadow: 0 2px 8px rgba(5, 30, 95, 0.12); text-decoration: none; color: var(--lsbc-text); }\n\n/* Need more help band */\n.lsbc-help { background: var(--lsbc-band); margin-top: 4rem; padding: 4rem 1rem; text-align: center; }\n.lsbc-help h2 { font-size: 2.5rem; font-weight: 700; margin: 0 0 0.75rem; }\n.lsbc-help > p { font-size: 1.2rem; margin: 0 0 3rem; }\n.lsbc-help__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; max-width: 1200px; margin: 0 auto; text-align: left; }\n.lsbc-help__card { display: flex; gap: 2rem; align-items: center; background: #fff; padding: 3rem 2.5rem; border-radius: 4px; }\n.lsbc-help__card img { width: 5rem; height: 5rem; flex: none; }\n.lsbc-help__card a { font-size: 1.5rem; font-weight: 600; color: var(--lsbc-blue); }\n.lsbc-help__card p { margin: 0.5rem 0 0; font-size: 1.15rem; }\n\n/* Footer */\n.lsbc-footer { background: #020B24; color: #E6E9F0; text-align: center; padding: 3rem 1rem 2.5rem; }\n.lsbc-footer__seal { width: 4.5rem; height: 4.5rem; display: block; margin: 0 auto 1rem; }\n.lsbc-footer__wordmark { width: 16rem; max-width: 80%; display: block; margin: 0 auto 1.25rem; }\n.lsbc-footer__address { margin: 0 0 1rem; }\n.lsbc-footer__links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2.5rem; margin: 0 0 1.5rem; padding: 0; }\n.lsbc-footer a { color: #E6E9F0; }\n.lsbc-footer a:hover, .lsbc-footer a:focus { color: #fff; }\n.lsbc-footer__copy { margin: 0; font-size: 0.95rem; }\n\n/* Keyboard focus everywhere */\na:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid var(--lsbc-gold); outline-offset: 2px; }\n\n/* Phone */\n@media (max-width: 768px) {\n  .forceCommunityThemeHeroStarter h1, .forceCommunityThemeHeroStarter .title { font-size: 2.25rem; }\n  .lsbc-popular, .lsbc-topics, .lsbc-help__cards { grid-template-columns: 1fr; gap: 1rem; }\n  .lsbc-popular__col + .lsbc-popular__col { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; margin-top: -1rem; }\n  .lsbc-tile { min-height: 9rem; }\n  .lsbc-help h2 { font-size: 2rem; }\n  .lsbc-help__card { padding: 2rem 1.5rem; }\n}\n\n/* Inner page headings and document list */\n.lsbc-page-title { font-family: \"Montserrat\", sans-serif; font-size: 2.25rem; font-weight: 700; color: #1B1B1F; margin: 1.5rem 0 0.5rem; }\n.lsbc-page-intro { font-size: 1.15rem; margin: 0 0 1.5rem; }\n.lsbc-doclist { list-style: none; padding: 0; margin: 0 0 1.5rem; background: #fff; border: 1px solid #D8DCE3; border-radius: 4px; }\n.lsbc-doclist__item { padding: 1rem 1.25rem; }\n.lsbc-doclist__item + .lsbc-doclist__item { border-top: 1px solid #D8DCE3; }\n.lsbc-doclist a { font-weight: 600; color: #1F4E9C; }\n\n\n/* Footer links: light on dark navy for contrast (override template link colour) */\n.lsbc-footer a, .lsbc-footer a:visited { color: #E6E9F0 !important; text-decoration: underline; }\n.lsbc-footer a:hover, .lsbc-footer a:focus { color: #FFFFFF !important; }\n/* Hero: the hero sits under the two-row header, so push the headline below the menu */\n.lpiInnerHero { padding-top: 190px !important; padding-bottom: 64px !important; }\n@media (max-width: 768px) { .lpiInnerHero { padding-top: 96px !important; padding-bottom: 40px !important; } }\n\n/* Hero, Hulu style: one centred column, gold line above a large white headline, then a full-width search */\n.lpiInnerHero .widthContainer { width: 100% !important; max-width: 1040px; padding: 0 20px; }\n.lpiInnerHero .content { width: 100% !important; display: flex; flex-direction: column; text-align: left; }\n.lpiInnerHero .contentSubtitle { order: -1; font-size: 1.6rem !important; font-weight: 500; margin: 0 0 0.4rem; }\n.lpiInnerHero .contentTitle { font-family: \"Montserrat\", sans-serif; font-size: 4rem !important; font-weight: 700; line-height: 1.1; margin: 0 0 2rem; }\n.lpiInnerHero .forceCommunityThemeSearchHero, .lpiInnerHero .search-wrapper, .lpiInnerHero form { width: 100% !important; max-width: none !important; }\n.lpiInnerHero input[type=\"search\"], .lpiInnerHero input[type=\"text\"] { height: 3.75rem !important; font-size: 1.15rem !important; border: 3px solid #C9A43A !important; border-radius: 6px !important; }\n@media (max-width: 768px) { .lpiInnerHero .contentTitle { font-size: 2.4rem !important; } .lpiInnerHero .contentSubtitle { font-size: 1.15rem !important; } }\n\n/* Navigation: the same on every page. White underline on the current page, no template teal */\n.comm-navigation__top-level-item-link, .comm-navigation__top-level-item-link:hover, .comm-navigation__top-level-item-link:focus { background: transparent !important; color: #FFFFFF !important; }\n.comm-navigation__top-level-item-link:hover { text-decoration: underline; }\n.comm-navigation__top-level-item-link--active { background: transparent !important; box-shadow: inset 0 -3px 0 #FFFFFF !important; }\n\n/* Inner pages: heading lines up with the centred content column */\n.lsbc-page-title, .lsbc-page-intro { max-width: 1000px; margin-left: auto !important; margin-right: auto !important; padding: 0 1rem; }\n.lsbc-page-title { margin-top: 2.5rem !important; }\n/* Forms list: description on its own line under the form name */\n.lsbc-doclist__item span { display: block; margin-top: 0.25rem; color: #4A4F5C; }\n.lsbc-doclist__item a { font-size: 1.1rem; }\n",
