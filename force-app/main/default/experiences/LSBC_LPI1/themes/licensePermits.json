            {
              "componentAttributes": {
                "richTextValue": "<!-- Site footer: seal, wordmark, address, links, copyright (dark navy, styled in the theme CSS) -->\n<footer class=\"lsbc-footer\" role=\"contentinfo\">\n\n  <!-- Board seal and wordmark -->\n  <img class=\"lsbc-footer__seal\" src=\"/sfsites/c/resource/PortalSeal\" alt=\"Seal of the Louisiana State Board of Cosmetology\">\n  <img class=\"lsbc-footer__wordmark\" src=\"/sfsites/c/resource/PortalLogoWhite\" alt=\"Louisiana State Board of Cosmetology\">\n\n  <!-- Address and phone -->\n  <p class=\"lsbc-footer__address\">\n    11622 Sunbelt Court, Baton Rouge, Louisiana 70809 &middot;\n    <a href=\"tel:+12257563404\">225-756-3404</a>\n  </p>\n\n  <!-- Links: placeholders to the Board's website until the portal has its own pages -->\n  <div class=\"lsbc-footer__links\">\n    <a href=\"https://www.lsbc.louisiana.gov\" target=\"_blank\" rel=\"noopener\">lsbc.louisiana.gov</a>\n    <a href=\"https://www.lsbc.louisiana.gov\" target=\"_blank\" rel=\"noopener\">Laws and Rules</a>\n    <a href=\"https://www.lsbc.louisiana.gov\" target=\"_blank\" rel=\"noopener\">Accessibility</a>\n    <a href=\"https://www.lsbc.louisiana.gov\" target=\"_blank\" rel=\"noopener\">Privacy</a>\n  </div>\n\n  <p class=\"lsbc-footer__copy\">&copy; State of Louisiana, Board of Cosmetology</p>\n</footer>"
              },
